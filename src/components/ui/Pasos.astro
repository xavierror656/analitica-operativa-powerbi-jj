---
interface Item {
  t: string;
  d: string;
}
interface Props {
  items: Item[];
  poco?: boolean;
}
const { items, poco = false } = Astro.props;
---

<ol data-cantidad={items.length} class:list={['pasos-lista gap-6 list-none p-0 m-0', items.length >= 5 ? 'pasos-columnas' : 'flex flex-col']}>
  {
    items.map((item, i) => (
      <li class:list={['flex items-start gap-6', { 'fragment fade-up': poco }]}>
        <span class="shrink-0 w-14 h-14 rounded-full bg-accent/20 border-2 border-accent flex items-center justify-center font-titulo font-bold text-2xl">
          {i + 1}
        </span>
        <span>
          <strong class="block text-3xl">{item.t}</strong>
          <span class="text-dim text-2xl">{item.d}</span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .pasos-columnas { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px 48px; }
  .pasos-lista li > span:last-child { min-width:0; }
</style>
