---
import catalogo from '../../data/animaciones.json';
interface Props { animacion: keyof typeof catalogo }
const { animacion } = Astro.props;
const ficha = catalogo[animacion];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<figure class="lottie-figure" data-lottie data-src={`${base}/animaciones/${animacion}.json`} data-animacion={animacion}>
  <div class="lottie-stage" role="img" aria-label={ficha.descripcion}>
    <img class="lottie-poster" src={`${base}/animaciones/${animacion}.svg`} alt="" width="640" height="480" />
    <canvas class="lottie-canvas" width="640" height="480" aria-hidden="true"></canvas>
  </div>
  <figcaption>
    <p class="lottie-leyenda">{ficha.leyenda}</p>
    <div class="lottie-actions"><button type="button" class="lottie-toggle" hidden>Reproducir animación</button></div>
    <a class="lottie-credit" href={'origen' in ficha ? ficha.origen : 'https://lottiefiles.com/es/'} target="_blank" rel="noopener">{ficha.credito} ↗</a>
  </figcaption>
</figure>
<script>
  import { conectarAnimaciones } from '../../lib/lottie-slides.mjs';
  import wasmUrl from '@lottiefiles/dotlottie-web/dotlottie-player.wasm?url';
  conectarAnimaciones({ document, window, cargar: async () => {
    const { DotLottie } = await import('@lottiefiles/dotlottie-web');
    DotLottie.setWasmUrl(wasmUrl);
    return DotLottie;
  } });
</script>
<style>
  .lottie-figure { margin:0; width:100%; max-width:500px; text-align:center; }
  .lottie-stage { position:relative; width:100%; aspect-ratio:4/3; background:#f4f7f6; border-radius:28px; overflow:hidden; }
  .lottie-poster,.lottie-canvas { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; }
  .lottie-canvas { opacity:0; }
  .lottie-figure[data-playing] .lottie-canvas { opacity:1; }
  .lottie-figure[data-playing] .lottie-poster { opacity:0; }
  :global(.reveal .slides section) .lottie-leyenda { font-size:26px; line-height:1.35; margin:18px 0 10px; }
  .lottie-toggle { cursor:pointer; font:600 24px var(--font-cuerpo); padding:10px 18px; border-radius:9px; color:inherit; border:2px solid currentColor; background:transparent; }
  .lottie-toggle[hidden] { display:none; }
  .lottie-credit { display:inline-block; font-size:24px; line-height:1.3; margin-top:12px; text-underline-offset:4px; }
  :global(html.pdf-export) .lottie-canvas,:global(html.pdf-export) .lottie-actions { display:none; }
  :global(html.pdf-export) .lottie-poster { opacity:1!important; }
  @media print { .lottie-canvas,.lottie-actions { display:none!important; }.lottie-poster { opacity:1!important; } }
  @media (prefers-reduced-motion:reduce) { .lottie-canvas { display:none; }.lottie-poster { opacity:1!important; }.lottie-actions { display:none; } }
</style>
