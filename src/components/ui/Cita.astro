---
interface Props {
  mono?: boolean;
}
const { mono = false } = Astro.props;
---

{
  mono ? (
    <pre class="bg-ink rounded-2xl px-10 py-8 font-codigo text-3xl leading-relaxed whitespace-pre-wrap"><code><slot /></code></pre>
  ) : (
    <blockquote class="font-titulo font-bold text-5xl leading-snug text-center px-16">
      <slot />
    </blockquote>
  )
}
