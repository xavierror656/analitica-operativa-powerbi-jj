---
interface Props {
  items: string[];
  poco?: boolean;
}
const { items, poco = false } = Astro.props;
---

<div class="flex flex-wrap gap-4">
  {
    items.map((item) => (
      <span
        class:list={[
          'px-8 py-4 rounded-full border-2 border-accent bg-accent/10 font-titulo font-bold text-3xl',
          { 'fragment fade-up': poco },
        ]}
      >
        {item}
      </span>
    ))
  }
</div>
