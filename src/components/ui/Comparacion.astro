---
interface Props {
  tituloA: string;
  tituloB: string;
}
const { tituloA, tituloB } = Astro.props;
---

<div class="grid grid-cols-2 gap-12 w-full">
  <div class="rounded-xl bg-ink-2/40 border border-white/10 p-8">
    <h4 class="font-titulo font-bold text-3xl mb-4">{tituloA}</h4>
    <div class="text-2xl">
      <slot name="a" />
    </div>
  </div>
  <div class="rounded-xl bg-accent/10 border border-accent p-8">
    <h4 class="font-titulo font-bold text-3xl mb-4">{tituloB}</h4>
    <div class="text-2xl">
      <slot name="b" />
    </div>
  </div>
</div>
