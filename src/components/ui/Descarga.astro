---
// Liga de descarga para participantes: fuente monoespaciada grande, ícono de
// descarga, target directo (no _blank: es un archivo, no una página).
import Icono from './Icono.astro';

interface Props {
  href: string;
  nombre: string;
  peso?: string;
}
const { href, nombre, peso } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  href={`${base}${href}`}
  download
  class="inline-flex items-center gap-4 rounded-xl border-2 border-accent bg-accent/10 px-8 py-5 font-codigo text-2xl hover:border-accent-light transition-colors"
>
  <Icono nombre="download" class="w-8 h-8 shrink-0 text-accent" />
  <span>{nombre}</span>
  {peso && <span class="text-dim text-xl">({peso})</span>}
</a>
