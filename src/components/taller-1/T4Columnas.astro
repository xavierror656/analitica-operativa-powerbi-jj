---
import Mecanismo from '../slides/Mecanismo.astro';
import Chips from '../ui/Chips.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo titulo="Ocho columnas, una hoja: MaintenanceData">
  <Chips
    items={[
      'Fecha',
      'Equipo',
      'Tipo_Falla',
      'Tiempo_Averia_Horas',
      'Tiempo_Reparacion_Horas',
      'Horas_Operativas',
      'Ordenes_Pendientes',
      'Disponibilidad_Porc',
    ]}
  />
  <Notas
    slot="notas"
    minutos={5}
    dice="Una fila es un evento de falla: qué equipo, cuánto tardó en repararse, cuántas horas operó antes de fallar. Con estas ocho columnas se construye todo el dashboard de hoy."
    nota="Disponibilidad_Porc ya viene calculada en el archivo. En la Instrucción 2 la van a recalcular con una medida propia, para entender de dónde sale."
  />
</Mecanismo>
