---
import Cierre from '../slides/Cierre.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Cierre diseno="cierre" evidencia="A4" titulo={"Comprueba cifras, rutas y comprensión"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"6 min · Cifras","d":"Mismo filtro, mismas medidas que A3."},{"t":"7 min · Recorrido","d":"Resumen → detalle → regreso → restablecer."},{"t":"5 min · Evidencia","d":"Registro de lector, nivel C4 y pendientes."}]} />
  </div>
  <Notas slot="notas" minutos={18} dice={"Validar una tarea con la fuente a mano; confirmar que el lector describe el alcance."} nota={"Una página atractiva con una cifra engañosa no está validada. Registrar el problema con su impacto."} />
</Cierre>
