---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';

---
<Mecanismo modulo="D4-M00" titulo={"Un reporte que otra área pueda usar"}>
  <div class="flex flex-col gap-8">
    <div class="day-roadmap"><div class="day-roadmap-item"><span class="day-time">08:00</span><strong>Decidir</strong><p>Jerarquía, color, gráficos y títulos</p></div><div class="day-roadmap-item"><span class="day-time">09:00</span><strong>Resumir</strong><p>Pregunta ejecutiva en una página</p></div><div class="day-roadmap-item"><span class="day-time">10:45</span><strong>Explorar</strong><p>Detalle con filtros y trazabilidad</p></div><div class="day-roadmap-item"><span class="day-time">13:15</span><strong>Interactuar</strong><p>Tooltips, marcadores y navegación</p></div><div class="day-roadmap-item"><span class="day-time">15:00</span><strong>Probar</strong><p>Lector de otra área, sin explicación</p></div><div class="day-roadmap-item"><span class="day-time">16:30</span><strong>Validar</strong><p>A4: resumen y detalle coherentes</p></div></div><a class="day-guide-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dia-04/guia/`} target="_blank" rel="noopener">Guía de trabajo y evidencia A4 ↗</a>
  </div>
  <Notas slot="notas" minutos={5} dice={"Hoy retomamos A3. El éxito se observa cuando otra persona entiende y usa el reporte."} nota={"PDF, Día 4 y C4. Dos niveles: resumen y detalle; las páginas auxiliares de tooltip no son otro nivel de negocio."} />
</Mecanismo>
