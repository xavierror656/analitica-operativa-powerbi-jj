---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno diseno="accion" modulo="D4-M13" titulo={"Lleva una línea del resumen al detalle"} minutos={10}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"En Detalle","d":"Agrega dim_linea[nombre_linea] a los campos de drillthrough."},{"t":"En Resumen","d":"Usa ese mismo campo en las barras por línea; clic derecho sobre una barra → Obtener detalles."},{"t":"Conserva y verifica","d":"Activa conservar filtros cuando aplique y comprueba fecha, línea y botón de regreso."}]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Mostrar primero la ruta de drillthrough, luego dejar que la pareja la repita."} nota={"El visual origen debe contener el campo de drillthrough. Un botón de navegación normal no transmite automáticamente la selección; distinguir ambos comportamientos."} />
</TuTurno>
