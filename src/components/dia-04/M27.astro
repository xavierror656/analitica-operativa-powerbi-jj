---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno modulo="D4-M27" titulo={"Completa tu reporte de dos niveles"} minutos={40}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–15 min · Cierra diseño","d":"Resumen, detalle, títulos, unidades y filtros visibles."},{"t":"15–30 min · Integra interacción","d":"Tooltip, formato, marcadores, botones y accesibilidad."},{"t":"30–40 min · Ensaya controles","d":"Contrasta contra A3 y prepara copia para el lector."}]} />
  </div>
  <Notas slot="notas" minutos={40} dice={"Trabajo autónomo; el instructor resuelve incidencias en cada área."} nota={"Evitar el retoque cosmético que retrase una ruta rota o una cifra sin contexto."} />
</TuTurno>
