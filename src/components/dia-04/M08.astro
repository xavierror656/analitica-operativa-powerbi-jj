---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno diseno="accion" modulo="D4-M08" titulo={"Configura indicadores que se puedan interpretar"} minutos={10}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Tarjetas desde medidas A3","d":"Piezas, % Cumplimiento y % Rechazo producción."},{"t":"Formato","d":"Enteros o porcentaje, unidades claras, sin abreviación que oculte la prueba."},{"t":"Alcance visible","d":"Fecha y línea/área a la vista. Mantenimiento tiene otra cobertura de filtros."}]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Crear una tarjeta y hacer que el grupo repita con las otras dos."} nota={"No usar columnas sumadas automáticamente para sustituir medidas de porcentaje. Si se añade mantenimiento al resumen, etiquetar que turno no lo filtra."} />
</TuTurno>
