---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo diseno="secuencia" modulo="D4-M26" titulo={"Dale al lector tareas, no instrucciones de clic"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Encuentra","d":"Piezas de L1 en mayo de 2025; identifica los filtros de tu respuesta."},{"t":"Explora","d":"Llega al detalle que sustenta esa cifra y regresa conservando el contexto previsto."},{"t":"Cambia y restablece","d":"Selecciona turno 1; explica qué indicadores responden y cómo restablecer la vista."}]} />
  </div>
  <Notas slot="notas" minutos={7} dice={"Entregar las tareas por escrito. El autor no habla ni mueve el cursor mientras el lector las intenta."} nota={"Registrar tiempo, errores, preguntas y cifra interpretada. Si debe intervenir el autor, anotar dónde y por qué."} />
</Mecanismo>
