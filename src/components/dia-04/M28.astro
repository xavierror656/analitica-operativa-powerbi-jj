---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Practica diseno="taller" modulo="D4-M28" titulo={"Observa al lector y corrige lo que falle"} minutos={30}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–10 min · Lectura sin ayuda","d":"Persona de otra área ejecuta las tres tareas; autor observa."},{"t":"10–20 min · Corrección","d":"Prioriza una cifra mal interpretada, una ruta rota o un filtro invisible."},{"t":"20–30 min · Repetición","d":"El lector vuelve a ejecutar la tarea; compara tiempo, resultado y explicación."}]} />
  </div>
  <Notas slot="notas" minutos={30} dice={"La prueba cumple el taller de la propuesta: lector de otra área sin explicación previa."} nota={"No confundir una opinión de gusto con una falla de uso. Conservar tarea, observación, cambio y resultado de la nueva prueba."} />
</Practica>
