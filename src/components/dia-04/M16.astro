---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Practica diseno="taller" modulo="D4-M16" titulo={"Arma el detalle sin perder la trazabilidad"} minutos={40}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–15 min · Tablas y campos","d":"Define grano, lote, fecha y unidad para cada zona."},{"t":"15–28 min · Ruta","d":"Configura drillthrough y regreso; comprueba dos líneas."},{"t":"28–40 min · Prueba independiente","d":"Tu pareja llega a un registro y explica qué filtros sí se aplican."}]} />
  </div>
  <Notas slot="notas" minutos={40} dice={"Actividad con menor guía. Cambiar quién opera; el autor de la primera página ahora observa."} nota={"Usar las medidas validadas de A3. Cualquier nueva medida o relación exige su propia prueba antes de incluirla en A4."} />
</Practica>
