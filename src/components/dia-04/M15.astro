---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<Mecanismo diseno="datos" modulo="D4-M15" titulo={"Navegar y filtrar son acciones distintas"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Acción","Configuración","Prueba"]} filas={[["Ir a otra página","Acción de navegación","Destino correcto"],["Ir al detalle seleccionado","Drillthrough con campo común","Misma línea y periodo"],["Volver al resumen","Botón de regreso","Contexto y navegación comprensibles"],["Compartir filtros entre páginas","Sincronización deliberada de segmentadores","No quedan selecciones invisibles"]]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Documentar qué acción usa cada botón antes de diseñarlo."} nota={"En modo edición de Desktop algunas acciones se prueban con Ctrl+clic; en lectura se usa clic. Confirmar el comportamiento según la versión del aula."} />
</Mecanismo>
