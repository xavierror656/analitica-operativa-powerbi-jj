---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Practica diseno="taller" modulo="D4-M23" titulo={"Integra las seis técnicas del laboratorio"} minutos={30}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–10 min · Interacciones y formato","d":"Una interacción intencional y una regla explicable."},{"t":"10–20 min · Tooltip","d":"Contexto heredado y alternativa accesible al detalle."},{"t":"20–30 min · Marcadores y botones","d":"Reset, navegación y regreso; repetir una selección adversa."}]} />
  </div>
  <Notas slot="notas" minutos={30} dice={"Seguir sobre el mismo A4. Circular y pedir que cada decisión responda una tarea del lector."} nota={"No añadir efectos solo para completar una lista. Documentar qué usuario se beneficia y cómo se verificó cada técnica."} />
</Practica>
