---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import Nota from '../ui/Nota.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<EjemploReal imagen="equipo" pieImagen="Diseña para la persona que toma la decisión" diseno="datos" modulo="D4-M01" titulo={"Empieza por la decisión del lector"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Lector","Pregunta","Resultado que debe encontrar"]} filas={[["Business Excellence","¿Qué cambió frente al periodo previo?","Tendencia y comparación válida"],["Operaciones","¿Qué línea y turno requieren revisión?","Detalle de producción filtrado"],["Ingeniería","¿Dónde se registraron rechazos?","Eventos por defecto y parte"]]} /><Nota>Una página no necesita responder todas las preguntas con todos los campos visibles.</Nota>
  </div>
  <Notas slot="notas" minutos={10} dice={"Pedir a cada área una decisión y una cifra que la sustente."} nota={"Usar las preguntas de sección 1 del PDF. Evitar una colección de gráficos sin tarea del lector."} />
</EjemploReal>
