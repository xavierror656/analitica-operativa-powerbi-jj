---
import '../styles/global.css';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
  </head>
  <body>
    <div class="reveal">
      <div class="slides">
        <slot />
      </div>
    </div>

    <script>
      import Reveal from 'reveal.js';
      import Notes from 'reveal.js/plugin/notes';

      const deck = new Reveal({
        width: 1920,
        height: 1080,
        margin: 0,
        minScale: 0.2,
        maxScale: 2,
        controls: true,
        progress: true,
        hash: true,
        center: false,
        transition: 'slide',
        plugins: [Notes],
      });
      deck.initialize();

      // S: notas del facilitador en otra ventana (plugin Notes)
      // F: pantalla completa · Esc: vista general — atajos nativos de Reveal.
    </script>
  </body>
</html>
