---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import Nota from '../ui/Nota.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<EjemploReal diseno="datos" modulo="D5-M09" titulo={"Un contraste real del dataset"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Medida","Abril 2025","Mayo 2025"]} filas={[["Piezas","343,875","337,491"],["Plan","383,895","377,764"],["% Cumplimiento","89.58 %","89.34 %"],["Minutos correctivos","3,930","3,298"]]} /><Nota>La producción baja 6,384 piezas (−1.86 %). También cambia el plan; estas cifras no prueban una causa.</Nota>
  </div>
  <Notas slot="notas" minutos={10} dice={"Guiar al grupo para explicar por qué menor volumen no equivale automáticamente a menor productividad."} nota={"No afirmar que el mantenimiento causó la baja. Los meses completos tienen distinta composición de registros, planes y calendario."} />
</EjemploReal>
