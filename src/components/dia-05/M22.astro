---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno modulo="D5-M22" titulo={"Reescribe la recomendación como una prueba"} minutos={10}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Hipótesis","d":"Qué explicación estás considerando."},{"t":"Acción acotada","d":"Qué registro o comparación revisarías para contrastarla."},{"t":"Criterio de seguimiento","d":"Qué resultado apoyaría o debilitaría la hipótesis."}]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Reescribir una recomendación del ensayo. Pedir que la acción sea viable y no dependa de una cifra inventada."} nota={"La propuesta de acción es didáctica. No ejecutar cambios de proceso productivo desde una capacitación."} />
</TuTurno>
