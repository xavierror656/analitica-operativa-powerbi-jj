---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo diseno="secuencia" modulo="D5-M27" titulo={"La rúbrica observa análisis y comunicación"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"1 · Inicial","d":"Sostiene el caso con apoyo directo en pasos críticos."},{"t":"2 · En desarrollo","d":"Interpreta y presenta autónomamente el caso practicado."},{"t":"3 · Competente","d":"Resuelve una variante nueva y justifica la recomendación."},{"t":"4 · Avanzado","d":"Detecta y corrige un error en el análisis de otro equipo y explica el criterio."}]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Evaluar trazabilidad, interpretación, límite causal, recomendación y comunicación bajo la escala del PDF."} nota={"A5 tiene peso doble respecto a A1–A3 en la propuesta. Registrar también aportación individual; la exposición en equipo no acredita automáticamente a todos."} />
</Mecanismo>
