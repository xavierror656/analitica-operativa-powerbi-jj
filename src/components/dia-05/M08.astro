---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo modulo="D5-M08" titulo={"Una cifra sola todavía no es un hallazgo"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Observación","d":"Qué cambió o dónde se concentra."},{"t":"Respaldo","d":"Medida, valor, unidad, periodo, filtros y fuente."},{"t":"Alcance","d":"Qué comparación es válida y qué conclusión no se puede sostener."}]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Usar el reporte A4 para responder una pregunta de Business Excellence."} nota={"Separar dato observado, interpretación e hipótesis; no escribir la recomendación antes de examinar el dato."} />
</Mecanismo>
