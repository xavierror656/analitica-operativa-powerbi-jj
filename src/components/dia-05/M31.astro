---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<Mecanismo modulo="D5-M31" titulo={"Comprueba el impacto a treinta días"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Pregunta de seguimiento del PDF","Qué registrar"]} filas={[["¿Quién sigue usando el reporte?","Uso concreto y frecuencia"],["¿Cuántas horas manuales estima haber reducido?","Estimación y forma de obtenerla"],["¿Qué decisión se tomó a partir del reporte?","Ejemplo, fecha y evidencia"]]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Cada participante define un uso y una forma sencilla de dar seguimiento. La encuesta posterior la aplica la empresa."} nota={"No enviar encuestas ni comprometer resultados desde la sesión. Las horas son estimaciones declaradas, no ahorros medidos automáticamente."} />
</Mecanismo>
