---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<EjemploReal diseno="datos" modulo="D5-M15" titulo={"Una recomendación debe ser proporcional a la evidencia"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["La evidencia permite","Propuesta defendible","Afirmación que se descarta"]} filas={[["Volumen y plan disminuyen","Revisar la programación y composición de ambos meses","La línea perdió productividad"],["Rechazos concentrados en una categoría","Revisar registros del defecto y su disposición","El defecto demuestra una causa raíz"],["Duración correctiva cambia","Investigar eventos y condiciones comparables","El mantenimiento causó el resultado de producción"]]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Pedir que reescriban una recomendación demasiado fuerte sin volverla vacía."} nota={"Usar acción verificable, no una promesa de ahorro o liberación de producto que el modelo no calcula."} />
</EjemploReal>
