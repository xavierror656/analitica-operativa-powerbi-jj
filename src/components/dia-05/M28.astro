---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno modulo="D5-M28" titulo={"Integra y congela la versión de exposición"} minutos={16}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–6 min · Archivo","d":"PBIX final, fuentes sintéticas y ruta probada."},{"t":"6–12 min · Evidencia","d":"Fichas A3, prueba A4, hallazgos y recomendación A5."},{"t":"12–16 min · Respaldo","d":"Exportación o capturas para contingencia; orden de intervención."}]} />
  </div>
  <Notas slot="notas" minutos={16} dice={"Trabajo autónomo final. No cambiar medidas verificadas durante los últimos minutos para arreglar un mensaje."} nota={"Si no se permite publicar, PBIX local y exportación bastan para el plan alterno del PDF. La demostración del servicio no exige acceso del participante."} />
</TuTurno>
