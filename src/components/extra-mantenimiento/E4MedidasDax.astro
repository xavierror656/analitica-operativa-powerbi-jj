---
import Mecanismo from '../slides/Mecanismo.astro';
import Codigo from '../ui/Codigo.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo modulo="D5-PF11" titulo="Las mismas dos fórmulas, en DAX">
  <div class="flex flex-col gap-8">
    <div>
      <p class="text-2xl font-titulo font-bold mb-3">MTTR (horas)</p>
      <Codigo codigo={`MTTR =
DIVIDE(
    SUM(MaintenanceData[Tiempo_Reparacion_Horas]),
    COUNTROWS(MaintenanceData)
)`} lenguaje="dax" />
    </div>
    <div>
      <p class="text-2xl font-titulo font-bold mb-3">MTBF (horas)</p>
      <Codigo codigo={`MTBF =
DIVIDE(
    SUM(MaintenanceData[Horas_Operativas]),
    COUNTROWS(MaintenanceData)
)`} lenguaje="dax" />
    </div>
  </div>
  <Notas
    slot="notas"
    minutos={10}
    dice="DIVIDE en vez de la barra normal, por la misma razón que en el Día 1 del programa completo: si algún día no hay fallas registradas, la barra normal truena, DIVIDE devuelve blanco."
    nota="COUNTROWS(MaintenanceData) cuenta cada fila como una falla. Si más adelante quieren MTTR por equipo, esta misma medida ya funciona sola dentro de una tabla o gráfico segmentado por Equipo, por el contexto de filtro."
  />
</Mecanismo>
