---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Codigo from '../ui/Codigo.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal diseno="formula" modulo="D5-PF12" titulo="Disponibilidad: la que ya viene, y la que calculas tú">
  <Comparacion tituloA="Columna del archivo" tituloB="Medida propia" iconoA="table" iconoB="sigma">
    <p slot="a" class="text-2xl">
      Disponibilidad_Porc: un número por fila, calculado por quien armó el archivo.
      Si segmentas por equipo o por mes, no se recalcula solo.
    </p>
    <div slot="b">
      <Codigo codigo={`Disponibilidad % =
DIVIDE(
    SUM(MaintenanceData[Horas_Operativas]),
    SUM(MaintenanceData[Horas_Operativas])
        + SUM(MaintenanceData[Tiempo_Averia_Horas])
)`} lenguaje="dax" />
    </div>
  </Comparacion>
  <Notas
    slot="notas"
    minutos={7}
    dice="Esta es la diferencia entre columna y medida que se ve en el Día 3 del programa completo, aquí con un ejemplo de mantenimiento: la columna es un número fijo por fila, la medida se recalcula según lo que estés viendo."
    pregunta="Si filtran solo la Extrusora 2, ¿la columna del archivo cambia? ¿Y la medida?"
    nota="La columna no cambia, sigue mostrando el promedio de todas las filas visibles fila por fila. La medida sí se recalcula, porque SUM respeta el filtro activo."
  />
</EjemploReal>
