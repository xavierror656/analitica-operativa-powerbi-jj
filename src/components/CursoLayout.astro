---
import '../styles/curso.css';
import Favicon from './Favicon.astro';
interface Props { titulo: string; descripcion: string; etiqueta?: string; inicio?: boolean; }
const { titulo, descripcion, etiqueta = 'ANALÍTICA OPERATIVA CON POWER BI', inicio = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} · Power BI</title>
    <Favicon />
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="course-header"><div class="course-width">
      <nav class="course-nav" aria-label="Navegación del curso">
        <a class="course-brand" href={base + '/'} aria-current={inicio ? 'page' : undefined}>Tecmilenio <span>· Johnson &amp; Johnson</span></a>
        <div class="course-actions"><a href={base + '/#programa'}>Los cinco días</a><a href={base + '/practicas/'}>Prácticas y materiales</a></div>
      </nav>
      <p class="eyebrow">{etiqueta}</p><h1>{titulo}</h1><p class="intro">{descripcion}</p><slot name="cabecera" />
    </div></header>
    <main class="course-width" id="contenido" tabindex="-1"><slot /></main>
    <footer class="course-width course-footer">Instructor: Javier A. Flores Flores · Ciudad Juárez <span>Datos sintéticos para capacitación</span></footer>
  </body>
</html>
