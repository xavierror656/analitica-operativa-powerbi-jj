---
import TuTurno from '../slides/TuTurno.astro';
import Pasos from '../ui/Pasos.astro';
import Notas from '../ui/Notas.astro';
---

<TuTurno modulo="D1-M18 · Extra" titulo="Conecta el archivo" minutos={15}>
  <Pasos
    poco
    items={[
      { t: 'Obtener datos', d: 'Power BI Desktop → Obtener datos → Excel → selecciona el archivo descargado.' },
      { t: 'Carga la hoja MaintenanceData', d: 'Es la única hoja del archivo.' },
      { t: 'Revisa los tipos de dato', d: 'Fecha debe quedar como fecha, las columnas de horas como decimal, no como texto.' },
      { t: 'Carga el modelo', d: 'Cerrar y aplicar.' },
    ]}
  />
  <Notas
    slot="notas"
    minutos={15}
    dice="Es la misma técnica que usaron esta mañana con la carpeta de CSV, solo que aquí el origen es un solo archivo Excel: Obtener datos → Excel en vez de Carpeta."
    nota="El objetivo de este extra es que reconozcan el patrón con un archivo que no es el del curso: Obtener datos, perfilar, cargar, sin importar la fuente."
  />
</TuTurno>
