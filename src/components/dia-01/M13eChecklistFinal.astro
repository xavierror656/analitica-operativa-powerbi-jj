---
import EjemploReal from '../slides/EjemploReal.astro';
import Chips from '../ui/Chips.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M13e" titulo="Checklist final antes del cierre" icono="list-checks">
  <Chips
    items={[
      '8 tablas separadas; ruta parametrizada',
      '9 anomalías: regla aplicada o excepción justificada',
      'Filas y piezas conciliadas; nulos declarados',
      'PBIX + bitácora; actualización y revisión cruzada',
    ]}
  />
  <Notas
    slot="notas"
    minutos={5}
    dice="Cuatro casillas. Si les falta una, es lo primero que resuelven antes de pasar a la validación del instructor."
    nota="Esto es literalmente el criterio de A1 en nivel 2 (En desarrollo), tal como se ve en la rúbrica de esta tarde."
  />
</EjemploReal>
