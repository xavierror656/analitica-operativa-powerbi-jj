---
import Mecanismo from '../slides/Mecanismo.astro';
import Pasos from '../ui/Pasos.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo diseno="secuencia" modulo="D1-M2" titulo="De la fuente al reporte: la arquitectura de Power BI" icono="layers">
  <Pasos
    items={[
      { t: 'Conectar', d: 'Power BI lee las fuentes de piso: carpetas, Excel, bases de datos. No copia y pega.' },
      { t: 'Transformar', d: 'Power Query limpia y deja pasos documentados, reproducibles cada vez que llega un archivo nuevo.' },
      { t: 'Modelar', d: 'Las tablas se relacionan: hechos de producción contra dimensiones de línea, turno y calendario.' },
      { t: 'Medir', d: 'DAX calcula los indicadores sobre el modelo, no sobre celdas sueltas.' },
      { t: 'Publicar', d: 'Se configura el acceso y la actualización en el servicio; publicar por sí solo no los resuelve.' },
    ]}
  />
  <Notas
    slot="notas"
    minutos={6}
    dice="Este es el mapa del programa: día 1 preparar, día 2 modelar, día 3 medir, día 4 diseñar el reporte y día 5 analizar y publicar. Hoy nos concentramos en los dos primeros pasos de esta lista."
    nota="No profundizar en DAX ni en modelado todavía, es solo el mapa. Volver a esta slide mentalmente cada vez que abran el Día correspondiente."
  />
</Mecanismo>
