---
import EjemploReal from '../slides/EjemploReal.astro';
import Quiz from '../ui/Quiz.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M3d" titulo="Chequeo rápido: ¿confiable o no?" icono="circle-question-mark">
  <Quiz
    pregunta='Recibes "produccion_final_v2.xlsx", armado con copiar y pegar. No hay fecha verificable ni proceso documentado. ¿Es una fuente confiable?'
    opciones={[
      { texto: 'Sí, basta con que el número final sea correcto' },
      { texto: 'No: falta verificar su actualización y reproducir el proceso', correcta: true },
      { texto: 'Sí, el formato Excel garantiza su confiabilidad' },
    ]}
    explicacion='La confiabilidad requiere origen, responsable, fecha y proceso verificables. Un número correcto hoy no garantiza una actualización reproducible.'
  />
  <Notas
    slot="notas"
    minutos={5}
    dice="Esto no es un caso hipotético, descríbanlo con detalle porque es casi seguro que a alguien en el salón le está pasando ahora mismo con algún archivo."
    nota="Si alguien contesta que sí es confiable porque 'el número está bien', esa es la discusión que vale la pena abrir: un número correcto hoy no dice nada sobre si seguirá siendo correcto ni verificable la próxima vez."
  />
</EjemploReal>
