---
import TuTurno from '../slides/TuTurno.astro';
import Pasos from '../ui/Pasos.astro';
import Notas from '../ui/Notas.astro';
---

<TuTurno modulo="D1-M19 · Extra" titulo="Arma las primeras tres visualizaciones" minutos={20}>
  <Pasos
    items={[
      { t: 'Una tarjeta', d: 'Suma de Ordenes_Pendientes: el número que alguien pregunta primero en una junta.' },
      { t: 'Un gráfico de líneas', d: 'Disponibilidad_Porc por Fecha: ¿sube o baja con el tiempo?' },
      { t: 'Una segmentación', d: 'Por Equipo: que cualquiera pueda filtrar a "solo Extrusora 2".' },
    ]}
  />
  <Notas
    slot="notas"
    minutos={20}
    dice="Tres visuales, no diez. La instrucción de hoy es que cada uno conteste una pregunta concreta, no llenar la página."
    nota="Si alguien termina antes, que pruebe cambiar el gráfico de líneas a promedio móvil de 7 días: se nota mucho mejor la tendencia con datos diarios ruidosos."
  />
</TuTurno>
