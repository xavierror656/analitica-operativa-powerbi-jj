  <RecetaGuiada id="laboratorio" />
  <Notas
    slot="notas"
    minutos={38}
    dice="Pueden seguir los pasos en pantalla, consultar las recetas y copiar las fórmulas. Al terminar, muestren cómo comprobaron cada resultado."
