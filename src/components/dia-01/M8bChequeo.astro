---
import EjemploReal from '../slides/EjemploReal.astro';
import Quiz from '../ui/Quiz.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal diseno="pregunta" modulo="D1-M8b" titulo="Chequeo rápido: ¿Power Query o DAX?" icono="circle-question-mark">
  <Quiz
    pregunta='Necesitas que "RETRABAJO" y "retrabajo" cuenten como el mismo valor antes de categorizar la fila. ¿Dónde lo resuelves?'
    opciones={[
      { texto: 'En Power Query, antes de cargar el modelo', correcta: true },
      { texto: 'En una medida DAX, cada vez que alguien abre el reporte' },
      { texto: 'No hace falta resolverlo, Power BI lo normaliza solo' },
    ]}
    explicacion='La limpieza de texto se aplica en Power Query en cada actualización. Una medida DAX responde al contexto de filtro; una columna calculada DAX también se calcula durante el procesamiento del modelo. Hoy normalizamos antes de cargar.'
  />
  <Notas
    slot="notas"
    minutos={4}
    dice="No es examen, nadie ve el resultado de nadie. Es para que se traben un segundo antes de seguir con el laboratorio."
    nota="Este reactivo es el mismo criterio que el 03 de la evaluación diagnóstica previa. Si alguien ya lo contestó ahí, se va a acordar, esa es la idea: reforzar, no sorprender."
  />
</EjemploReal>
