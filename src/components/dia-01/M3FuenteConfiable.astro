---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M3" titulo="¿Cuándo una fuente es confiable?">
  <Comparacion tituloA="Archivo suelto" tituloB="Fuente confiable">
    <ul slot="a" class="flex flex-col gap-3 list-disc pl-6">
      <li>Vive en el escritorio de una persona</li>
      <li>Cambia de nombre cada mes</li>
      <li>Nadie sabe quién lo actualizó por última vez</li>
    </ul>
    <ul slot="b" class="flex flex-col gap-3 list-disc pl-6">
      <li>Vive en una carpeta de red o base de datos</li>
      <li>Estructura de columnas estable</li>
      <li>Tiene dueño y hora de actualización conocida</li>
    </ul>
  </Comparacion>
  <Notas
    slot="notas"
    minutos={10}
    dice="La pregunta no es si el archivo tiene errores, todos los tienen. La pregunta es si sabes cuándo y de dónde vienen."
    pregunta="¿Cuántos de ustedes hoy sacan su reporte de un archivo que vive en el escritorio de alguien?"
    nota="Casi todo el grupo va a levantar la mano. No corregir, solo anotar: eso es exactamente lo que el Día 1 empieza a resolver."
  />
</EjemploReal>
