---
import Mecanismo from '../slides/Mecanismo.astro';
import Chips from '../ui/Chips.astro';
import Icono from '../ui/Icono.astro';
import Notas from '../ui/Notas.astro';

const hechos = [
  { nombre: 'fact_produccion', icono: 'factory', cols: 'fecha, turno, hora_inicio, linea_id, parte_id, lote, piezas_plan, piezas_producidas, piezas_buenas, horas_operacion, horas_paro' },
  { nombre: 'fact_calidad', icono: 'shield-check', cols: 'fecha, linea_id, parte_id, lote, tipo_defecto, etapa_deteccion, piezas_rechazadas, disposicion, inspector_id' },
  { nombre: 'fact_mantenimiento', icono: 'wrench', cols: 'fecha_evento, equipo_id, linea_id, tipo, duracion_min, causa, afecta_produccion' },
];
---

<Mecanismo modulo="D1-M4b" titulo="Los ocho archivos, con sus columnas reales">
  <div class="flex flex-col gap-8">
    <div class="grid grid-cols-3 gap-6">
      {
        hechos.map((h) => (
          <div class="rounded-xl bg-ink-2/40 border border-white/10 p-6">
            <Icono nombre={h.icono} class="w-7 h-7 text-accent mb-3" />
            <p class="font-codigo text-xl font-bold text-accent mb-3">{h.nombre}</p>
            <p class="text-base text-dim leading-snug">{h.cols}</p>
          </div>
        ))
      }
    </div>
    <div>
      <p class="flex items-center gap-3 text-2xl font-titulo font-bold mb-4">
        <Icono nombre="folder" class="w-6 h-6 text-dim" />
        Dimensiones (catálogos)
      </p>
      <Chips items={['dim_linea', 'dim_parte', 'dim_turno', 'dim_defecto', 'dim_calendario']} />
    </div>
  </div>
  <Notas
    slot="notas"
    minutos={7}
    dice="No memoricen las columnas, es para que las tengan enfrente cuando abran el archivo. Lo que sí quiero que noten: los tres 'fact_' son eventos que pasan en el tiempo, las dimensiones son catálogos que casi no cambian."
    nota="Esta distinción hecho/dimensión es la base del Día 2. No hace falta profundizar hoy, solo sembrarla."
  />
</Mecanismo>
