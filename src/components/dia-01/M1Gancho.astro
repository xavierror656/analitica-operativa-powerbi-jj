---
import Gancho from '../slides/Gancho.astro';
import Notas from '../ui/Notas.astro';
---

<Gancho
  modulo="D1-M1"
  titulo="Un reporte confiable no empieza en el gráfico"
  pregunta="¿En qué parte del proceso creen que aparece el primer error de un reporte?"
>
  <Notas
    slot="notas"
    minutos={5}
    dice="Antes de tocar Power BI: todo reporte que han visto fallar, falló mucho antes del gráfico. Hoy vamos a la fuente."
    pregunta="¿En qué parte del proceso creen que aparece el primer error de un reporte?"
    nota="Dejar que respondan 2-3 personas. Casi siempre dicen 'en la fórmula' o 'en el gráfico'. Nadie dice 'en la captura'. Esa es la entrada al fundamento."
  />
</Gancho>
