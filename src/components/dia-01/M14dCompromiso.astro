---
import Cierre from '../slides/Cierre.astro';
import Cita from '../ui/Cita.astro';
import Notas from '../ui/Notas.astro';
---

<Cierre titulo="Antes de irse">
  <Cita>Con tu PBIX, bitácora y guía abiertos, muestra qué cambió el total de piezas y un caso donde conservaste el vacío. Explica tu decisión con esa evidencia.</Cita>
  <Notas
    slot="notas"
    minutos={2}
    dice="Un minuto para escribir y otro para contrastar con la pareja. Cierra anotando una regla que vas a aplicar en tu trabajo."
  />
</Cierre>
