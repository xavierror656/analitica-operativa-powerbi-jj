---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import RecetaGuiada from './RecetaGuiada.astro';
---

<EjemploReal diseno="receta" modulo="D1-M8d" titulo="Combina archivos solo si representan la misma tabla">
  <RecetaGuiada id="carpeta" />
  <Notas
    slot="notas"
    minutos={6}
    dice="El dataset de hoy trae un archivo por tabla, pero en planta van a tener un archivo por mes o por turno. Conectar a la carpeta es lo que hace que esa acumulación no les vuelva a doler."
    nota="Demo en una carpeta aparte: dos CSV de producción con periodos que no se traslapen. Verificar que filas combinadas = filas archivo 1 + filas archivo 2. No copiar el mismo archivo dos veces: eso duplicaría producción. El README del día 1 explica la preparación para el facilitador; los dos CSV los proporciona el instructor."
  />
</EjemploReal>
