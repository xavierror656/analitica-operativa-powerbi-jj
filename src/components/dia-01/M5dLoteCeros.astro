---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M5d" titulo="El lote perdió sus ceros a la izquierda">
  <Comparacion tituloA="Como llegó" tituloB="Como debe quedar" iconoA="circle-x" iconoB="circle-check-big">
    <p slot="a" class="font-codigo text-3xl">lote: "2609-7"</p>
    <p slot="b" class="font-codigo text-3xl">lote: "2609-0007"</p>
  </Comparacion>
  <Notas
    slot="notas"
    minutos={7}
    dice="Aquí el generador quitó un cero del sufijo a propósito. El lote es texto: separar por guion, completar el sufijo a cuatro caracteres y volver a unir. No atribuir este ejemplo al comportamiento automático de Excel."
    pregunta="¿Por qué importa que el lote tenga los ceros exactos, en un contexto de dispositivos médicos?"
    nota="Regla de este ejercicio: prefijo AAMM y secuencia de cuatro dígitos. Aplicarla también en fact_calidad. Guardar el valor original. La guía incluye Text.PadStart; fuera del ejercicio, no inventar ceros sin una especificación del identificador."
  />
</EjemploReal>
