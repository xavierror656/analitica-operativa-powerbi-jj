---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
---

<Practica
  modulo="D1-M5"
  titulo="Turnos, líneas y lotes en orden"
  consigna="En pareja: dejen fact_produccion con nombres de línea consistentes, turno como número y lote con sus ceros a la izquierda. Documenten cada paso aplicado en Power Query."
  pregunta="Si mañana llega un archivo nuevo del mismo formato, ¿tus pasos lo limpian solos?"
  minutos={50}
>
  <Notas
    slot="notas"
    minutos={50}
    dice="La prueba de que su limpieza sirve no es que el archivo de hoy quede bonito. Es que el archivo de mañana, con el mismo problema, se arregle solo."
    nota="Esta es la actividad núcleo 2 del Día 1, con menor guía que la anterior. El instructor circula, no arma el archivo en pantalla salvo que un problema se generalice."
  />
</Practica>
