---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import RecetaGuiada from './RecetaGuiada.astro';
---

<Practica diseno="receta"
  modulo="D1-M5"
  titulo="Turnos, líneas y lotes en orden"
  minutos={38}
>
  <RecetaGuiada id="limpieza" />
  <Notas
    slot="notas"
    minutos={38}
    dice="La prueba de que su limpieza sirve no es que el archivo de hoy quede bonito. Es que el archivo de mañana, con el mismo problema, se arregle solo."
    nota="6 min: subtotales y duplicados; 8 min: líneas y fechas; 16 min: horas, turnos y lotes; 8 min: verificación. Comparar L1–L4 con dim_linea. Retirar solo duplicados exactos en producción, sobre columnas originales y antes de agregar un índice. No deduplicar eventos de calidad por parecido."
  />
</Practica>
