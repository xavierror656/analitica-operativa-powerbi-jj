---
import EjemploReal from '../slides/EjemploReal.astro';
import Quiz from '../ui/Quiz.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal diseno="pregunta" modulo="D1-M10b" titulo="Chequeo rápido: manejo de errores" icono="circle-question-mark">
  <Quiz
    pregunta="Tu consulta trae 40 filas con la hora en un formato que Power Query no reconoce, de 7,000 totales. ¿Qué haces?"
    opciones={[
      { texto: 'Borro las 40 filas y sigo, para no perder tiempo' },
      { texto: 'Aíslo las 40 filas en una tabla de errores y documento cuántas y por qué', correcta: true },
      { texto: 'Dejo que la consulta falle hasta corregir la fuente original' },
    ]}
    explicacion="Separar permite investigar sin perder trazabilidad: 6,960 válidas + 40 excepciones = 7,000 entradas. Documenta el impacto. Si esas filas afectan un indicador crítico, el responsable debe decidir si se puede usar el resultado incompleto."
  />
  <Notas
    slot="notas"
    minutos={4}
    dice="Las tres opciones parecen razonables en el momento. Solo una deja rastro de que el problema existió."
    nota="Conecta directo con la Nota crítica de la slide anterior: aislar no es lo mismo que ignorar."
  />
</EjemploReal>
