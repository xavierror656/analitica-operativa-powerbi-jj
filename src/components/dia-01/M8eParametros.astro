---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import RecetaGuiada from './RecetaGuiada.astro';
---

<EjemploReal modulo="D1-M8e" titulo="Configura una ruta con un parámetro" icono="sliders-horizontal">
  <RecetaGuiada id="parametro" />
  <Notas
    slot="notas"
    minutos={6}
    dice="Un parámetro es una casilla que Power Query trata como constante en todas las consultas que lo usan. Hoy les ahorra reescribir la ruta ocho veces; en planta les va a ahorrar reescribirla cada vez que IT mueva la carpeta de servidor."
    nota="Inicio → Administrar parámetros → Nuevo: RutaDatos, tipo Texto. En cada consulta sustituir únicamente la ruta dentro de File.Contents, conservando Csv.Document y sus opciones. Las funciones M se escriben en inglés incluso con la interfaz en español."
  />
</EjemploReal>
