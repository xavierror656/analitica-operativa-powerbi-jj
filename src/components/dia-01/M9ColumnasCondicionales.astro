---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Cita from '../ui/Cita.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M9" titulo="Columnas condicionales anidadas: de disposición a categoría">
  <div class="flex flex-col gap-10">
    <Comparacion tituloA="Columna cruda (disposicion)" tituloB="Columna nueva (categoria_scrap)" iconoA="circle-x" iconoB="circle-check-big">
      <ul slot="a" class="flex flex-col gap-3 list-disc pl-6 font-codigo text-2xl">
        <li>"Retrabajo"</li>
        <li>"Desecho"</li>
        <li>"Concesión"</li>
      </ul>
      <ul slot="b" class="flex flex-col gap-3 list-disc pl-6">
        <li>Recuperable</li>
        <li>Pérdida total</li>
        <li>Aceptado con desviación</li>
      </ul>
    </Comparacion>
    <Cita mono>{`let d = if [disposicion] = null then ""
        else Text.Lower(Text.Trim([disposicion]))
in if d = "retrabajo" then "Recuperable"
else if d = "desecho" then "Pérdida total"
else if d = "concesión" then "Aceptado con desviación"
else "Revisar"`}</Cita>
  </div>
  <Notas
    slot="notas"
    minutos={8}
    dice="Una condicional sola resuelve dos casos. En planta casi siempre hay tres o más, y ahí es donde la gente anida mal o hace cinco columnas sueltas. La regla: una columna, todas las condiciones, en el orden en que de verdad ocurren."
    pregunta="¿Dónde terminarían un valor vacío y una disposición que nadie había visto antes?"
    nota="Probar Retrabajo, RETRABAJO, Desecho, Concesión, null y un texto desconocido. Las últimas dos entradas deben quedar como Revisar; nunca como una aceptación automática. La clasificación es didáctica, no una autorización de liberación."
  />
</EjemploReal>
