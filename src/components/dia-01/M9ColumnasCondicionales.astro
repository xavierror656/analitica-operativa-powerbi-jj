---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import RecetaGuiada from './RecetaGuiada.astro';
---

<EjemploReal diseno="receta" modulo="D1-M9" titulo="Clasifica las disposiciones de calidad">
  <RecetaGuiada id="condicional" />
  <Notas
    slot="notas"
    minutos={8}
    dice="Una condicional sola resuelve dos casos. En planta casi siempre hay tres o más, y ahí es donde la gente anida mal o hace cinco columnas sueltas. La regla: una columna, todas las condiciones, en el orden en que de verdad ocurren."
    pregunta="¿Dónde terminarían un valor vacío y una disposición que nadie había visto antes?"
    nota="Probar Retrabajo, RETRABAJO, Desecho, Concesión, null y un texto desconocido. Las últimas dos entradas deben quedar como Revisar; nunca como una aceptación automática. La clasificación es didáctica, no una autorización de liberación."
  />
</EjemploReal>
