---
import Mecanismo from '../slides/Mecanismo.astro';
import Pasos from '../ui/Pasos.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo modulo="D1-M13b" titulo="Cómo se evalúa la evidencia A1" icono="award">
  <Pasos
    items={[
      { t: '1 · Inicial', d: 'Completaste la limpieza con apoyo directo del instructor en pasos críticos.' },
      { t: '2 · En desarrollo', d: 'La completaste sin apoyo, con el dataset del programa. Es la meta mínima de hoy.' },
      { t: '3 · Competente', d: 'Además, puedes explicar por qué elegiste cada paso, no solo que funciona.' },
      { t: '4 · Avanzado', d: 'Detectas y corriges un error en el archivo de un compañero, y sustentas la corrección.' },
    ]}
  />
  <Notas
    slot="notas"
    minutos={8}
    dice="Esta es la misma escala de dominio de toda la propuesta del programa, aplicada por primera vez hoy. No es una calificación numérica, es qué tan lejos de 'apoyado' están."
    nota="Nivel 2 es la meta de acreditación mínima por competencia, según la propuesta. Nivel 4 no es obligatorio hoy, pero quien termine rápido puede llegar ahí auditando a un compañero."
  />
</Mecanismo>
