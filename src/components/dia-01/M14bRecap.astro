---
import Cierre from '../slides/Cierre.astro';
import Chips from '../ui/Chips.astro';
import Notas from '../ui/Notas.astro';
---

<Cierre titulo="Lo que se llevan hoy">
  <Chips
    poco
    items={[
      'Tres tablas conectadas por carpeta',
      'Nueve anomalías identificadas y documentadas',
      'Una condicional anidada de verdad',
      'Un archivo que otra persona puede auditar',
    ]}
  />
  <Notas
    slot="notas"
    minutos={5}
    dice="No es un resumen de diapositivas, es literalmente lo que tienen abierto ahora mismo en su computadora."
  />
</Cierre>
