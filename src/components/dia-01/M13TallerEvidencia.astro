---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import RecetaGuiada from './RecetaGuiada.astro';
---

<TuTurno diseno="receta" modulo="D1-M13" titulo="Comprueba y entrega la evidencia A1" minutos={35}>
  <RecetaGuiada id="evidencia" />
  <Notas
    slot="notas"
    minutos={35}
    dice="Este es su archivo, el mismo que van a reutilizar los próximos cuatro días. Lo que dejen mal documentado hoy, lo van a pagar el jueves."
    nota="Distribución de los 35 min: 15 completar reglas, 10 conciliar, 5 documentar, 5 guardar y actualizar. La guía contiene la plantilla. Si falta tiempo, priorizar trazabilidad y declarar pendientes; no sustituir faltantes por cero para completar una lista."
  />
</TuTurno>
