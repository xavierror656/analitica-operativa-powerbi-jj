---
import Mecanismo from '../slides/Mecanismo.astro';
import TablaCurso from '../ui/TablaCurso.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo diseno="explicacion" modulo="D1-M17 · Extra" titulo="Ocho columnas, una hoja: MaintenanceData">
  <TablaCurso columnas={['Excel · campo exacto', 'Tipo en Power Query', 'Uso en el panel']} filas={[
    ['A · Fecha', 'Fecha', 'Eje X de la línea'],
    ['B · Equipo', 'Texto', 'Segmentación'],
    ['C · Tipo_Falla', 'Texto', 'Detalle del evento'],
    ['D · Tiempo_Averia_Horas', 'Número decimal', 'Apoyo; no se usa para MTTR'],
    ['E · Tiempo_Reparacion_Horas', 'Número decimal', 'MTTR: promedio'],
    ['F · Horas_Operativas', 'Número decimal', 'MTBF didáctico: promedio'],
    ['G · Ordenes_Pendientes', 'Número entero', 'Apoyo; no sumar como saldo actual'],
    ['H · Disponibilidad_Porc', 'Número decimal', 'Promedio / 100 → formato %'],
  ]} />
  <Notas
    slot="notas"
    minutos={5}
    dice="Una fila es un evento de falla: qué equipo, cuánto tardó en repararse, cuántas horas operó antes de fallar."
    nota="Disponibilidad_Porc es un valor proporcionado, en escala 0–100, sin base de tiempo documentada para reconstruirlo. La medida DAX del extra calcula su promedio y lo divide entre 100 para usar formato porcentaje. Los cálculos se crean en Power BI."
  />
</Mecanismo>
