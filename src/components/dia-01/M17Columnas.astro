---
import Mecanismo from '../slides/Mecanismo.astro';
import Chips from '../ui/Chips.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo diseno="explicacion" modulo="D1-M17 · Extra" titulo="Ocho columnas, una hoja: MaintenanceData">
  <Chips
    items={[
      'Fecha',
      'Equipo',
      'Tipo_Falla',
      'Tiempo_Averia_Horas',
      'Tiempo_Reparacion_Horas',
      'Horas_Operativas',
      'Ordenes_Pendientes',
      'Disponibilidad_Porc',
    ]}
  />
  <Notas
    slot="notas"
    minutos={5}
    dice="Una fila es un evento de falla: qué equipo, cuánto tardó en repararse, cuántas horas operó antes de fallar."
    nota="Disponibilidad_Porc ya viene calculada en el archivo, columna por columna. Más adelante en el programa, cuando ya se haya visto DAX, van a recalcularla con una medida propia y notar la diferencia."
  />
</Mecanismo>
