---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M5b" titulo="Nombre de línea inconsistente">
  <Comparacion tituloA="Cuatro formas de escribir lo mismo" tituloB="Un solo estándar" iconoA="circle-x" iconoB="circle-check-big">
    <ul slot="a" class="flex flex-col gap-3 list-disc pl-6 font-codigo text-2xl">
      <li>"L1"</li>
      <li>"Línea 1"</li>
      <li>"LINEA_1"</li>
      <li>"linea1"</li>
    </ul>
    <ul slot="b" class="flex flex-col gap-3 list-disc pl-6 font-codigo text-2xl">
      <li>"L1"</li>
    </ul>
  </Comparacion>
  <Notas
    slot="notas"
    minutos={7}
    dice="Cuatro etiquetas pueden fragmentar el resultado de una sola línea o dejar registros fuera del catálogo. Estandarizar el nombre no debe cambiar el total de piezas."
    pregunta="¿Por qué creen que Power BI no detecta esto solo?"
    nota="Porque para Power BI son cuatro textos distintos, no sabe que se refieren a lo mismo. Reemplazar valores o una columna condicional resuelve esto en Power Query."
  />
</EjemploReal>
