---
import Cierre from '../slides/Cierre.astro';
import Pasos from '../ui/Pasos.astro';
import Cita from '../ui/Cita.astro';
import Notas from '../ui/Notas.astro';
---

<Cierre titulo="Validación y cierre" evidencia="A1">
  <div class="flex flex-col gap-14">
    <Pasos
      items={[
        { t: 'Contrastar cifras contra la fuente', d: 'Una suma de piezas_producidas del archivo limpio contra el archivo original: deben coincidir.' },
        { t: 'Revisión cruzada', d: 'Intercambien archivos con un compañero de otra área. Si no le entienden sus pasos, no está listo.' },
        { t: 'Registrar la evidencia', d: 'El archivo depurado y documentado queda como A1: es la base de los cuatro días que siguen.' },
      ]}
    />
    <Cita>Mañana no empiezan de cero. Empiezan del archivo que dejaron hoy.</Cita>
  </div>
  <Notas
    slot="notas"
    minutos={30}
    dice="El Día 2 abre directamente con este archivo: si algo quedó mal documentado o inconsistente, el modelo de datos de mañana hereda el problema."
    pregunta="¿Alguien encontró algo en el archivo de su compañero que no hubiera visto en el propio?"
    nota="Cerrar registrando quién completó A1 con qué nivel de apoyo (Escala de dominio de la propuesta: 1 a 4), no solo si lo terminó."
  />
</Cierre>
