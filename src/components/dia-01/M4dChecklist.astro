---
import Mecanismo from '../slides/Mecanismo.astro';
import Chips from '../ui/Chips.astro';
import Notas from '../ui/Notas.astro';
---

<Mecanismo diseno="explicacion" modulo="D1-M4d" titulo="Lo que van a encontrar al perfilar (hay nueve)" icono="list-checks">
  <Chips
    items={[
      'Fechas en más de un formato',
      'Nombre de línea inconsistente (L1 / Línea 1 / LINEA_1)',
      'Hora en 12 y en 24 horas',
      'Lote sin ceros a la izquierda',
      'Filas duplicadas',
      'Filas de subtotal mezcladas con el detalle',
      'Horas de paro vacías: dato desconocido, no cero',
      'Código de defecto con espacios de más',
      'Turno capturado con nombre de supervisor',
    ]}
  />
  <Notas
    slot="notas"
    minutos={7}
    dice="Son nueve, no menos, no es una lista para asustar: es la lista exacta de lo que van a encontrar, porque el dataset del curso los siembra a propósito. Cada uno que encuentren es una técnica de Power Query que van a necesitar mañana también."
    nota="Si alguien encuentra los nueve antes de que termine el bloque, pídanle que audite el archivo de un compañero de otra área: es la mejor forma de usar el tiempo que le sobra."
  />
</Mecanismo>
