---
import EjemploReal from '../slides/EjemploReal.astro';
import Descarga from '../ui/Descarga.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal diseno="recurso" modulo="D1-M16 · Extra" titulo="Descarga el archivo antes de seguir">
  <div class="flex flex-col gap-8">
    <p class="text-3xl">
      150 registros de mantenimiento de una planta con extrusoras, cortadoras y
      selladoras: una fila por evento de falla, con fecha, equipo, tipo de falla y
      tiempos de reparación y operación.
    </p>
    <Descarga href="/descargas/Data_Mantenimiento_2025.xlsx" nombre="Data_Mantenimiento_2025.xlsx" peso="16 KB" />
  </div>
  <Notas
    slot="notas"
    minutos={3}
    dice="Descárguenlo ahora: las siguientes slides trabajan directo sobre este archivo."
    nota="Este Excel se utiliza en el extra de conexión, indicadores y visualización. Las siguientes diapositivas definen los cuatro indicadores y su alcance; conservar este ejercicio separado de A1."
  />
</EjemploReal>
