---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Cita from '../ui/Cita.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M4c" titulo="Ejemplo didáctico: tres reglas sobre una fila">
  <Comparacion tituloA="Como llega" tituloB="Como debe quedar" iconoA="circle-x" iconoB="circle-check-big">
    <div slot="a">
      <Cita mono>{`fecha: 21/09/2026
turno: 1
linea_id: LINEA_1
lote: 2609-7`}</Cita>
    </div>
    <div slot="b">
      <Cita mono>{`fecha: 2026-09-21
turno: 1
linea_id: L1
lote: 2609-0007`}</Cita>
    </div>
  </Comparacion>
  <Notas
    slot="notas"
    minutos={6}
    dice="Esta fila es ilustrativa, no una fila literal del ZIP. Tres problemas: fecha con formato diferente, línea inconsistente y lote sin ceros. Convertir una fecha a tipo Fecha no es lo mismo que elegir cómo se muestra."
    nota="No corregirla en esta slide, solo mostrarla. La corrección es el trabajo del bloque que sigue."
  />
</EjemploReal>
