---
import EjemploReal from '../slides/EjemploReal.astro';
import Comparacion from '../ui/Comparacion.astro';
import Cita from '../ui/Cita.astro';
import Notas from '../ui/Notas.astro';
---

<EjemploReal modulo="D1-M4c" titulo="Así se ve una fila cruda de fact_produccion">
  <Comparacion tituloA="Como llega" tituloB="Como debe quedar">
    <div slot="a">
      <Cita mono>{`fecha: 21/09/2026
turno: 1
linea_id: LINEA_1
lote: 2609-7`}</Cita>
    </div>
    <div slot="b">
      <Cita mono>{`fecha: 2026-09-21
turno: 1
linea_id: L1
lote: 2609-0007`}</Cita>
    </div>
  </Comparacion>
  <Notas
    slot="notas"
    minutos={6}
    dice="Esto no es un caso extremo, es una fila normal del archivo que están a punto de abrir. Tres problemas distintos en tres campos: fecha en otro formato, nombre de línea inconsistente, y lote que perdió ceros."
    nota="No corregirla en esta slide, solo mostrarla. La corrección es el trabajo del bloque que sigue."
  />
</EjemploReal>
