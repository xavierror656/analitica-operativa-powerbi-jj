---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo modulo="D2-M06" titulo={"1, asterisco y flecha cuentan historias distintas"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"1 → clave única","d":"En dim_linea hay una fila por linea_id; en producción la misma línea aparece muchas veces."},{"t":"* → múltiples registros","d":"Que la clave se repita en el hecho es normal. Su grano debe seguir siendo consistente."},{"t":"Flecha → dirección del filtro","d":"Para este modelo, filtro único desde dimensión hacia hecho. Relación activa, línea continua."}]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Abrir una relación en el modelo de demostración y distinguir cardinalidad de dirección."} nota={"Si Desktop presenta *:1 al elegir primero el hecho, es la misma relación inversa. Ambos no es una solución automática: puede abrir rutas ambiguas."} />
</Mecanismo>
