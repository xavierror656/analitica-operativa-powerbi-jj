---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<Mecanismo modulo="D2-M09" titulo={"Prueba las claves antes de dibujar relaciones"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Dimensión","Clave del lado 1","Valores esperados en el ZIP"]} filas={[["dim_linea","linea_id","4 únicos"],["dim_parte","parte_id","5 únicos"],["dim_turno","nombre","3 únicos: texto 1, 2 y 3"],["dim_defecto","defecto_id","6 únicos"],["dim_calendario","fecha","549 fechas únicas, sin huecos"]]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"En Power Query, perfilado completo: comparar filas, valores distintos y nulos de la clave. Mostrar que una dimensión con clave repetida no cumple el lado 1."} nota={"Después, combinación anti izquierda desde el hecho al catálogo para buscar claves sin correspondencia. Esa consulta es diagnóstico, no una combinación que sustituya al hecho."} />
</Mecanismo>
