---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno diseno="accion" modulo="D2-M28" titulo={"Organiza y diagnostica tu modelo"} minutos={40}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–12 min · Jerarquías y formatos","d":"Calendario y área/línea; meses ordenados y unidades explícitas."},{"t":"12–22 min · Campos y descripciones","d":"Oculta claves redundantes, describe el grano y deja dimensiones utilizables."},{"t":"22–40 min · Falla controlada en una copia","d":"Desactiva una relación de fecha. Predice, observa, diagnostica, restaura y repite."}]} />
  </div>
  <Notas slot="notas" minutos={40} dice={"El trabajo sigue sobre el archivo del día. Guardar copia de prueba antes de provocar la falla; no dejarla en el entregable."} nota={"Apoyo: entregar mapa de relaciones. Avanzados: diagnóstico de clave sin correspondencia en una copia pequeña. No mezclar estos datos artificiales con el ZIP."} />
</TuTurno>
