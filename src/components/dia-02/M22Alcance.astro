---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import ControlesModelo from './ControlesModelo.astro';
---
<EjemploReal modulo="D2-M22" titulo={"No sumes como detalle lo que sigue siendo un total"}>
  <div class="flex flex-col gap-8">
    <ControlesModelo casos={[3,4,5]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Comparar las tarjetas bajo cada filtro independiente. El total de producción por defecto se repetiría si se usara un eje que no lo filtra."} nota={"Repetir el total en cada defecto no lo convierte en producción atribuida a ese defecto. Evitar sumar esas filas manualmente; documentar el alcance. Comida 12:15–13:15."} />
</EjemploReal>
