---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import referencia from '../../data/controles-dia-02.json';
import modelo from '../../data/modelo-dia-02.json';
const hechos = ['fact_produccion', 'fact_calidad', 'fact_mantenimiento'] as const;
const casos = referencia.casos.slice(3);
const filtra = (caso: (typeof casos)[number], hecho: string) => Object.keys(caso.filtros).some(campo => modelo.relaciones.some(r => r[0] === campo.split('.')[0] && r[2] === hecho));
---
<EjemploReal diseno="datos" modulo="D2-M22" titulo={"Qué cambia con cada filtro"}>
  <div class="flex flex-col gap-8">
    <p>Aplica una prueba a la vez y limpia los filtros antes de la siguiente.</p>
    <table class="tabla-curso alcance-modelo">
      <thead><tr><th scope="col">Filtro de dimensión</th><th scope="col">Producción · piezas</th><th scope="col">Calidad · piezas</th><th scope="col">Mantenimiento · min</th></tr></thead>
      <tbody>{casos.map(caso => <tr>
        <th scope="row">{caso.caso}</th>
        {hechos.map(hecho => <td>
          <strong>{caso.valores[hecho].total.toLocaleString('es-MX')}</strong>
          <span class:list={['alcance', { 'sin-ruta':!filtra(caso, hecho) }]}>{filtra(caso, hecho) ? 'Filtrado por esta dimensión' : 'Total sin ese filtro'}</span>
        </td>)}
      </tr>)}</tbody>
    </table>
    <p class="alcance-conclusion"><strong>Que el total permanezca puede ser correcto.</strong> Turno no filtra calidad ni mantenimiento; parte no filtra mantenimiento; defecto solo filtra calidad.</p>
  </div>
  <Notas slot="notas" minutos={8} dice={"Comparar las tarjetas bajo cada filtro independiente. El total de producción por defecto se repetiría si se usara un eje que no lo filtra."} nota={"Repetir el total en cada defecto no lo convierte en producción atribuida a ese defecto. Evitar sumar esas filas manualmente; documentar el alcance. Comida 12:15–13:15."} />
</EjemploReal>
<style>
  .alcance-modelo { width:100%; font-size:27px; border-collapse:collapse; }
  .alcance-modelo td strong { font-size:33px; }
  .alcance { display:block; margin-top:10px; font-size:23px; color:#18518a; }
  .sin-ruta { color:#79520d; }
  :global(.reveal) .alcance-conclusion { font-size:29px; line-height:1.4; margin:0; }
</style>
