---
interface Props {
  pasos: { titulo:string; detalle:string }[];
  control:string;
  resultado:string;
}
const { pasos, control, resultado } = Astro.props;
---
<div class="receta-modelo">
  <ol>{pasos.map(p => <li><strong>{p.titulo}</strong><p>{p.detalle}</p></li>)}</ol>
  <aside>
    <strong>Comprueba en tu archivo</strong>
    <p>{control}</p>
    <strong>Resultado esperado</strong>
    <p>{resultado}</p>
  </aside>
</div>
<style>
  .receta-modelo { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); gap:56px; align-items:start; }
  :global(.reveal) .receta-modelo ol { margin:0; padding-left:42px; list-style:decimal; display:grid; gap:26px; }
  :global(.reveal) .receta-modelo li { padding-left:8px; font-size:29px; line-height:1.3; }
  :global(.reveal) .receta-modelo li p { font-size:27px; line-height:1.35; margin:8px 0 0; }
  .receta-modelo li::marker { font-weight:700; }
  .receta-modelo aside { padding:26px 30px; border-top:7px solid #f5c65a; background:#fff; color:#153750; border-radius:12px; }
  .receta-modelo aside strong { display:block; font-size:27px; }
  :global(.reveal) .receta-modelo aside p { font-size:29px; line-height:1.4; margin:12px 0 28px; }
  :global(.reveal) .receta-modelo aside p:last-child { margin-bottom:0; }
</style>
