---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo modulo="D2-M23" titulo={"Una jerarquía ordena la exploración"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Calendario: año → mes → fecha","d":"Crea la jerarquía con columnas de dim_calendario."},{"t":"Ordena nombre_mes por mes","d":"Enero debe ir antes de febrero; usa anio para separar años."},{"t":"Línea: área → nombre de línea","d":"Ambos niveles provienen de dim_linea; explica qué conserva el detalle."}]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Crear una jerarquía explícita y probar expandir niveles en una matriz simple. Distinguir nombre_mes de anio + mes."} nota={"La jerarquía no crea relaciones ni corrige filtros. Los nombres de mes se repiten entre años: no comparar periodos distintos sin el nivel año."} />
</Mecanismo>
