---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo modulo="D2-M19" titulo={"Si un filtro no responde, revisa la ruta"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"¿Qué campo origina el filtro?","d":"Busca una columna de dimensión, no la clave de un hecho."},{"t":"¿La relación está activa y llega a ese hecho?","d":"Revisa columnas, tipos, marcas 1/* y dirección."},{"t":"¿Coinciden las claves y la prueba visual?","d":"Comprueba correspondencias; después revisa filtros e interacciones del visual."}]} />
  </div>
  <Notas slot="notas" minutos={12} dice={"En la copia del instructor, desactivar calendario → mantenimiento. Filtrar una fecha, observar y reconstruir la ruta hasta encontrar la causa."} nota={"Restaurar la relación y repetir exactamente la misma prueba. No activar Ambos a ciegas. El tratamiento profundo de interacciones corresponde al día 4."} />
</Mecanismo>
