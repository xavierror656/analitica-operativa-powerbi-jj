---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno diseno="accion" modulo="D2-M13" titulo={"Construye la primera relación conmigo"} minutos={7}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Vista Modelo → Administrar relaciones → Nueva","d":"Selecciona dim_linea[linea_id] y fact_produccion[linea_id]."},{"t":"Confirma antes de aceptar","d":"Lado 1 en dimensión, lado * en hecho; dirección única; activa."},{"t":"Prueba una tabla","d":"Filas: dim_linea[nombre_linea]. Valores: suma de piezas_producidas."}]} />
  </div>
  <Notas slot="notas" minutos={7} dice={"El instructor construye; los participantes repiten. Detenerse antes de aceptar para que lean los cuatro ajustes."} nota={"Comprobar que el total no cambió y que las líneas reparten ese total. Si la interfaz ordena las tablas al revés, leer las marcas 1 y *."} />
</TuTurno>
