---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Practica modulo="D2-M21" titulo={"Responde tres preguntas con evidencia"} minutos={38}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–12 min · Comparación de líneas","d":"Predice y registra los tres controles al filtrar L1."},{"t":"12–24 min · Periodo y línea","d":"Valida el corte 01/03/2025 + L1 contra la fuente depurada."},{"t":"24–38 min · Alcance del filtro","d":"Prueba turno 1 y parte P-1001. Explica qué hechos no deben cambiar."}]} />
  </div>
  <Notas slot="notas" minutos={38} dice={"Menor guía: una persona opera y otra predice; intercambian papeles en el segundo corte. El instructor acompaña el razonamiento sin dictar los clics."} nota={"Solicitar tabla de prueba con filtro, esperado, observado y fuente. No aceptar una captura sin selección visible."} />
</Practica>
