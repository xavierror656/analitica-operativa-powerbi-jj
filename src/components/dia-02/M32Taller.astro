---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno modulo="D2-M32" titulo={"Termina el modelo que entregarás como A2"} minutos={50}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–20 min · Completa y organiza","d":"Claves, relaciones, jerarquías y propiedades del modelo."},{"t":"20–35 min · Verifica","d":"Controles sin filtro, L1, fecha + L1 y alcance de turno."},{"t":"35–50 min · Documenta y guarda","d":"PBIX, captura, bitácora y pendientes declarados."}]} />
  </div>
  <Notas slot="notas" minutos={50} dice={"Trabajo autónomo. Circular por área y resolver donde el participante está trabajando, como señala el PDF."} nota={"No reemplazar autonomía con copiar el archivo del instructor. Para nivel 3, reservar una variante distinta de los ejercicios guiados y registrar decisiones y prueba."} />
</TuTurno>
