---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<Mecanismo modulo="D2-M16" titulo={"Pregúntale al modelo con el nivel de detalle correcto"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Área","Pregunta de hoy","Dimensión que la sostiene"]} filas={[["Business Excellence","¿Cómo se comparan las líneas en el periodo?","Calendario y línea"],["Operaciones","¿Cuántas piezas produjo mi turno?","Turno → producción"],["Ingeniería","¿Qué defectos concentran los rechazos?","Defecto y parte → calidad"]]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Pedir una predicción de qué visual cambiará al filtrar cada pregunta. Usamos sumas de control, no indicadores nuevos."} nota={"Las preguntas se adaptan a las tres áreas de la sección 1 del PDF. No se infiere una causa de scrap a partir de coincidir con un mantenimiento."} />
</Mecanismo>
