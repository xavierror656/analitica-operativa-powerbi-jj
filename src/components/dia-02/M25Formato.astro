---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo diseno="secuencia" modulo="D2-M25" titulo={"Los nombres y formatos también previenen errores"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Describe el propósito","d":"En la descripción de cada hecho: grano, origen y límites de uso."},{"t":"Identificadores → no resumir","d":"Códigos y claves no se suman. Piezas y duracion_min se verifican con suma."},{"t":"Etiqueta las unidades","d":"Piezas enteras; mantenimiento en minutos. No mezclar con horas de producción."}]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Configurar las propiedades en paralelo durante unos minutos. Verificar que el visual usa Suma y no Recuento por un tipo de dato incorrecto."} nota={"El generador puede registrar dos partes en un mismo turno y repetir horas por registro. No sumar horas_operacion como horas únicas de línea ni calcular disponibilidad hoy."} />
</Mecanismo>
