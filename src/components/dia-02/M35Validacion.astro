---
import Cierre from '../slides/Cierre.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Cierre diseno="cierre" evidencia="A2" titulo={"Valida A2 antes de continuar"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"6 min · Totales y cortes","d":"Repite sin filtros, L1 y fecha + L1. Explica cualquier diferencia."},{"t":"7 min · Revisión final","d":"Otro participante confirma el alcance de turno, parte y defecto."},{"t":"5 min · Registro","d":"Entrega PBIX y bitácora; el instructor registra nivel de dominio y evidencia."}]} />
  </div>
  <Notas slot="notas" minutos={18} dice={"Contrastar contra la fuente depurada, no únicamente contra el archivo del compañero. El modelo debe mantener los resultados de A1."} nota={"Revisar fuente y filtros antes de cambiar fórmulas. Conservar también la prueba que demuestra que un filtro NO aplica a un hecho."} />
</Cierre>
