---
import Cierre from '../slides/Cierre.astro';
import Notas from '../ui/Notas.astro';
import ConceptoAnimado from '../ui/ConceptoAnimado.astro';
import Nota from '../ui/Nota.astro';
import Descarga from '../ui/Descarga.astro';
import { existsSync } from 'node:fs';

const archivoReferencia = 'dia-02-referencia-pbip.zip';
const referenciaDisponible = existsSync(`public/descargas/referencias/${archivoReferencia}`);
---
<Cierre diseno="cierre" evidencia="A2" titulo={"Mañana: indicadores sobre un modelo comprobado"}>
  <ConceptoAnimado animacion="indicadores">
  <div class="flex flex-col gap-8">
    <p>Conserva tu PBIX A2, su bitácora y una copia de respaldo. El día 3 empieza con este modelo.</p><Nota>Anota una relación que puedas justificar y una pregunta que el modelo todavía no puede responder.</Nota>
    {referenciaDisponible && <Descarga href={`/descargas/referencias/${archivoReferencia}`} nombre="Descargar proyecto A2 de referencia (.zip)" />}
  </div>
  </ConceptoAnimado>
  <Notas slot="notas" minutos={5} dice={"Cerrar con una decisión concreta de modelado que la persona aplicará en su área."} nota={"Antes de inteligencia de tiempo clásica del día 3, completar años del calendario según el periodo de análisis y volver a validar. No ampliar hoy el alcance a medidas, seguridad o publicación."} />
</Cierre>
