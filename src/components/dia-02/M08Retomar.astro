  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Guarda como Apellido_Nombre_A2.pbix","d":"Conserva A1 como punto de recuperación."},{"t":"Actualiza y comprueba","d":"Ocho tablas separadas, tipos revisados y conciliación disponible."},{"t":"Revisa relaciones existentes","d":"Inventaría las autodetectadas; compara con el mapa antes de corregirlas en la copia."}]} />
