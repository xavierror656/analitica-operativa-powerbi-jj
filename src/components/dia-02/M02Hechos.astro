---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<Mecanismo diseno="datos" modulo="D2-M02" titulo={"Una fila debe tener un significado preciso"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Tabla","Una fila representa","Dato que puedes agregar"]} filas={[["fact_produccion","Día · línea · turno · parte, con lote","piezas_producidas"],["fact_calidad","Un evento de rechazo","piezas_rechazadas"],["fact_mantenimiento","Un registro de mantenimiento / orden de trabajo","duracion_min"]]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Hecho es lo que ocurrió; dimensión es cómo lo describes. Leer una fila de cada tabla del archivo A1 y completar la frase: esta fila representa..."} nota={"La propuesta usa orden de trabajo. El CSV no trae orden_id: no inventar una clave única de orden ni afirmar que equipo_id identifica una orden. El generador es una simplificación."} />
</Mecanismo>
