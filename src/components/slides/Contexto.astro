---
// Una frase clave, grande, sin nada más. Fondo claro.
interface Props {
  modulo?: string;
}
const { modulo } = Astro.props;
---

<section class="is-light">
  <div class="flex flex-col items-start gap-8 max-w-[1400px]">
    {modulo && <span class="font-codigo text-2xl text-accent">{modulo}</span>}
    <p class="text-7xl font-titulo font-bold leading-tight">
      <slot />
    </p>
  </div>
  <slot name="notas" />
</section>
