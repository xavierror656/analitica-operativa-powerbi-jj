---
// Trabajo en equipo. Lleva consigna y pregunta. Fondo oscuro.
import Cronometro from '../ui/Cronometro.astro';

interface Props {
  modulo?: string;
  titulo: string;
  consigna?: string;
  pregunta?: string;
  minutos?: number;
}
const { modulo, titulo, consigna, pregunta, minutos } = Astro.props;
---

<section>
  <div class="flex flex-col gap-10 h-full">
    <div class="flex items-center justify-between">
      <div class="flex flex-col gap-4">
        {modulo && <span class="font-codigo text-2xl text-accent-light">{modulo}</span>}
        <h2>Práctica: {titulo}</h2>
      </div>
      {minutos !== undefined && <Cronometro minutos={minutos} />}
    </div>
    {consigna && <p class="text-3xl">{consigna}</p>}
    <div class="flex-1 flex flex-col justify-center">
      <slot />
    </div>
    {pregunta && (
      <p class="text-3xl font-titulo font-bold text-accent-light">{pregunta}</p>
    )}
  </div>
  <slot name="notas" />
</section>
