---
// Cierre del día: validación de cifras, revisión cruzada, registro de evidencia. Fondo oscuro.
import Icono from '../ui/Icono.astro';

interface Props {
  titulo: string;
  evidencia?: string;
  icono?: string;
}
const { titulo, evidencia, icono } = Astro.props;
---

<section>
  <div class="slide-body gap-10">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-4">
        {icono && <Icono nombre={icono} class="w-10 h-10 text-accent-light shrink-0" />}
        {titulo}
      </h2>
      {evidencia && (
        <span class="rounded-full bg-accent px-6 py-2 font-titulo text-2xl font-bold text-ink">
          Evidencia {evidencia}
        </span>
      )}
    </div>
    <slot />
  </div>
  <slot name="notas" />
</section>
