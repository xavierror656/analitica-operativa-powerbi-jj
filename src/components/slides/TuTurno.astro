---
// Tarea individual en la herramienta. Lleva minutos. Fondo oscuro.
interface Props {
  modulo?: string;
  titulo: string;
  minutos?: number;
}
const { modulo, titulo, minutos } = Astro.props;
---

<section>
  <div class="flex flex-col gap-10 h-full">
    <div class="flex items-center justify-between">
      <div class="flex flex-col gap-4">
        {modulo && <span class="font-codigo text-2xl text-accent-light">{modulo}</span>}
        <h2>Tu turno: {titulo}</h2>
      </div>
      {minutos !== undefined && (
        <span class="font-titulo font-bold text-6xl text-accent-light">{minutos} min</span>
      )}
    </div>
    <div class="flex-1 flex flex-col justify-center">
      <slot />
    </div>
  </div>
  <slot name="notas" />
</section>
