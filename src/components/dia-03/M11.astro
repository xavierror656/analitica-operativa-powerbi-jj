  <Notas slot="notas" minutos={10} dice={"Revisar una prueba por mesa antes del receso."} nota={"Guardar A3. Receso 10:30–10:45. Los ejemplos de contexto se conservan como auxiliares, no como nuevos indicadores obligatorios."} />
</EjemploReal>
