  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Mismo filtro","d":"Anota tabla, columna y selección exacta."},{"t":"Misma fuente","d":"Compara la suma con producción depurada."},{"t":"Misma definición","d":"Revisa unidad, denominador y cualquier filtro que CALCULATE reemplace."}]} />
