---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Mecanismo modulo="D3-M25" titulo={"A3 demuestra cálculo y control del contexto"}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"1 · Inicial","d":"Completa con apoyo directo en pasos críticos."},{"t":"2 · En desarrollo","d":"Construye y valida autónomamente los seis indicadores practicados."},{"t":"3 · Competente","d":"Resuelve una variante no vista y justifica denominador y filtros."},{"t":"4 · Avanzado","d":"Detecta, corrige y explica un error en medidas de otra persona."}]} />
  </div>
  <Notas slot="notas" minutos={8} dice={"Aplicar la escala oficial de sección 4. Separar dominio observado de simple terminación."} nota={"No asignar nivel 3 por copiar todas las fórmulas ni nivel 4 por revisar sin un hallazgo sustentado."} />
</Mecanismo>
