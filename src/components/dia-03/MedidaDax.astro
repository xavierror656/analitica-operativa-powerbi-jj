---
import medidas from '../../data/medidas-dia-03.json';
import Codigo from '../ui/Codigo.astro';
interface Props { id: string; }
const { id } = Astro.props;
const medida = medidas.find(m => m.id === id);
if (!medida) throw new Error('Medida desconocida: ' + id);
---
<Codigo codigo={medida.nombre + ' =\n' + medida.expresion} lenguaje="dax" />
<p class="texto-chico text-dim mt-4">Formato: {medida.formato} · Unidad: {medida.unidad}</p>
