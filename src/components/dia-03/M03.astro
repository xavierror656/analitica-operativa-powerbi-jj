---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<Mecanismo diseno="datos" modulo="D3-M03" titulo={"Elige columna o medida según la pregunta"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Necesidad","Opción","Momento de cálculo"]} filas={[["Normalizar un código de captura","Power Query","En cada actualización"],["Clasificar cada registro de forma persistente","Columna, si hace falta","Procesamiento del modelo"],["Sumar piezas según la selección","Medida","Consulta del visual"]]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Pedir tres ejemplos del archivo y clasificar antes de tocar Nueva medida."} nota={"No presentar DAX como reemplazo universal de Power Query ni afirmar que toda fórmula DAX se recalcula con cada filtro."} />
</Mecanismo>
