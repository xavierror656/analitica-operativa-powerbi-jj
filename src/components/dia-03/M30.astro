    <Pasos items={[{"t":"6 min · Recalcula","d":"Un control global y un corte con fecha."},{"t":"7 min · Contrasta","d":"El revisor confirma numeradores, denominadores y no aplica."},{"t":"5 min · Registra","d":"Evidencia A3, nivel de dominio y pendientes."}]} />
