---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import TablaCurso from '../ui/TablaCurso.astro';
---
<EjemploReal modulo="D3-M24" titulo={"Cierra el laboratorio con cifras y supuestos"}>
  <div class="flex flex-col gap-8">
    <TablaCurso columnas={["Prueba","Referencia","Qué demuestra"]} filas={[["Mayo 2025","337,491 piezas","Periodo actual"],["Abril 2025","343,875 piezas","Periodo anterior"],["Variación mayo / abril","−1.85648855 %","División sobre periodo anterior"],["MTD al 07/05/2025","77,234 piezas","Corte acumulado"],["Móvil 7d al 07/05/2025","11,033.42857 piezas/día","Ventana calendario"]]} />
  </div>
  <Notas slot="notas" minutos={10} dice={"Pedir que reproduzcan una cifra y expliquen por qué no se presenta igual una ventana parcial."} nota={"No afirmar que el verificador externo ejecuta DAX: son valores esperados derivados de la fuente. Receso 14:45–15:00."} />
</EjemploReal>
