---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Practica diseno="taller" modulo="D3-M23" titulo={"Dos rutas, la misma evidencia verificable"} minutos={35}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"Ruta de refuerzo","d":"15 min con filtro y DIVIDE; 15 min para MTD y mes anterior guiados; 5 min de contraste."},{"t":"Ruta autónoma","d":"Construye MTD, anterior, variación y móvil; prueba el cambio de mes y un periodo sin cobertura."},{"t":"Ambas rutas","d":"Documentan al menos un contraste temporal. El instructor demuestra las cuatro técnicas al grupo."}]} />
  </div>
  <Notas slot="notas" minutos={35} dice={"Aplicar la bifurcación prevista en la página impresa 6 del PDF. Quien va avanzado trabaja autónomo mientras se refuerza contexto con el resto."} nota={"No dejar al grupo de apoyo solo ni suprimir los contenidos temporales: todos los observan; cambia el grado de acompañamiento, que se registra."} />
</Practica>
