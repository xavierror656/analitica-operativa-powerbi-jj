---
import EjemploReal from '../slides/EjemploReal.astro';
import Notas from '../ui/Notas.astro';
import Nota from '../ui/Nota.astro';
import MedidaDax from '../dia-03/MedidaDax.astro';
---
<EjemploReal diseno="formula" modulo="D3-M14" titulo={"Producción y calidad responden preguntas distintas"}>
  <div class="flex flex-col gap-8">
    <MedidaDax id="rechazo" /><Nota>[No conformes producción] = [Piezas] − [Buenas]. Para desglosar por defecto usa [Rechazadas calidad], no una tasa de turno con un numerador que ignora turno.</Nota>
  </div>
  <Notas slot="notas" minutos={10} dice={"Aplicar turno 1 y mostrar qué tablas cambian. Reconciliar rechazo de calidad con la diferencia de producción solo en cortes compatibles."} nota={"No llamar scrap a todos los rechazos: fact_calidad distingue disposiciones de retrabajo, desecho y concesión. Tampoco etiquetar % Buenas como rendimiento de primera pasada sin esa definición."} />
</EjemploReal>
