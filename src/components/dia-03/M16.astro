---
import Practica from '../slides/Practica.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<Practica modulo="D3-M16" titulo={"Construye y documenta los seis indicadores"} minutos={40}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–15 min · Fórmulas y formatos","d":"Crea las seis medidas y sus auxiliares; no cambies los nombres a mitad de la validación."},{"t":"15–30 min · Fecha, turno y área","d":"Contrasta los cortes indicados; marca no aplica cuando no existe esa dimensión."},{"t":"30–40 min · Prueba de borde","d":"Selecciona un periodo sin datos y explica el blanco. Intercambia quién opera."}]} />
  </div>
  <Notas slot="notas" minutos={40} dice={"Actividad con menor guía. Cada pareja produce una ficha por indicador, incluida su limitación."} nota={"Conservar el alcance original de A2. No añadir relaciones bidireccionales para forzar a mantenimiento a cambiar por turno."} />
</Practica>
