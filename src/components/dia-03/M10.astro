---
import TuTurno from '../slides/TuTurno.astro';
import Notas from '../ui/Notas.astro';
import Pasos from '../ui/Pasos.astro';
---
<TuTurno modulo="D3-M10" titulo={"Predice y prueba el contexto"} minutos={40}>
  <div class="flex flex-col gap-8">
    <Pasos items={[{"t":"0–12 min · Bases","d":"Crea Piezas, Plan y Buenas; valida sin filtros."},{"t":"12–25 min · Reemplazo","d":"Compara la medida de turno 3 con distintos valores del segmentador nombre."},{"t":"25–40 min · Denominador","d":"Prueba participación con línea, área y fecha. Registra qué filtros se conservan."}]} />
  </div>
  <Notas slot="notas" minutos={40} dice={"Construir en paralelo al inicio; retirar ayuda gradualmente. Checkpoints en minutos 12 y 25."} nota={"Solicitar una explicación de la ruta de filtro, no solo una captura de números. Mantener registros de A1 y relaciones A2 intactos."} />
</TuTurno>
