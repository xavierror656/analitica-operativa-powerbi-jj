---
import Mecanismo from '../slides/Mecanismo.astro';
import Notas from '../ui/Notas.astro';

---
<Mecanismo diseno="ruta" modulo="D3-M00" titulo={"Una cifra con definición, contexto y respaldo"}>
  <div class="flex flex-col gap-8">
    <div class="day-roadmap"><div class="day-roadmap-item"><span class="day-time">08:00</span><strong>Comprender</strong><p>Fila, filtro, sintaxis y variables</p></div><div class="day-roadmap-item"><span class="day-time">09:00</span><strong>Calcular</strong><p>Medidas y contexto de filtro</p></div><div class="day-roadmap-item"><span class="day-time">10:45</span><strong>Definir</strong><p>Seis indicadores del grupo</p></div><div class="day-roadmap-item"><span class="day-time">13:15</span><strong>Comparar</strong><p>Acumulados, periodos y promedio móvil</p></div><div class="day-roadmap-item"><span class="day-time">15:00</span><strong>Demostrar</strong><p>Medidas documentadas y auditadas</p></div><div class="day-roadmap-item"><span class="day-time">16:30</span><strong>Validar</strong><p>A3 lista para diseñar el reporte</p></div></div><a class="day-guide-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dia-03/guia/`} target="_blank" rel="noopener">Guía de trabajo y evidencia A3 ↗</a>
  </div>
  <Notas slot="notas" minutos={5} dice={"Retomamos A2 y guardamos A3. Hoy cada indicador debe tener nombre, unidad, fórmula y alcance."} nota={"PDF, sección 3, Día 3 y C3. Pausas: 10:30, 12:15–13:15 y 14:45. Seis indicadores propuestos para el caso, no impuestos por la propuesta."} />
</Mecanismo>
