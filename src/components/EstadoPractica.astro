---
const { id } = Astro.props;
---
<div class="practice-progress">
  <label for={'estado-'+id}>Mi avance · práctica {id.replace('-', '.')}</label>
  <select class="select select-bordered" id={'estado-'+id} data-actividad-estado={id}>
    <option value="pendiente">Pendiente</option>
    <option value="en-proceso">En proceso</option>
    <option value="terminada">Terminada</option>
  </select>
  <small role="status" aria-live="polite">Se guarda en este navegador.</small>
</div>
