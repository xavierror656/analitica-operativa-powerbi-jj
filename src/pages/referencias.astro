---
import CursoLayout from '../components/CursoLayout.astro';
import referencias from '../data/referencias.json';
import DistintivoDia from '../components/DistintivoDia.astro';
import { existsSync } from 'node:fs';
for (const r of referencias) {
  if (r.archivo && (!/^dia-0[1-5]-referencia\.pbix$/.test(r.archivo) || !r.revision || !existsSync(`public/descargas/referencias/${r.archivo}`))) throw new Error(`Referencia del día ${r.dia}: falta archivo o revisión`);
}
---
<CursoLayout titulo="Modelos de referencia" descripcion="Archivos del caso base para comparar tu trabajo y retomar la clase desde el cierre de cada día.">
  <p>Conserva tu entrega antes de abrir una referencia. Al recibir un modelo, ajusta RutaDatos a tu carpeta y comprueba la actualización con los controles de la guía.</p>
  <div class="activity-grid">{referencias.map(r=><section class="activity-card" data-dia={r.dia}>
    <DistintivoDia dia={r.dia}/>
    <h2>Día {r.dia} · {r.titulo}</h2>
    {r.archivo ? <><a class="button" href={'/descargas/referencias/'+r.archivo} download>Descargar referencia A{r.dia}</a><p>Revisión: {r.revision}</p></> : <p>El modelo de referencia de este día todavía no está disponible.</p>}
    <a href={'/dia-0'+r.dia+'/guia/'}>Consultar guía y controles del día {r.dia}</a>
  </section>)}</div>
</CursoLayout>
