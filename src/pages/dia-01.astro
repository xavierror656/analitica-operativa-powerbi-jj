---
import RevealDeck from '../components/RevealDeck.astro';
import Acto from '../components/ui/Acto.astro';
import Notas from '../components/ui/Notas.astro';
import M0Ruta from '../components/dia-01/M0Ruta.astro';

// 08:00 Fundamento
import M1Gancho from '../components/dia-01/M1Gancho.astro';
import M1bQueNoEs from '../components/dia-01/M1bQueNoEs.astro';
import M1cTresAreas from '../components/dia-01/M1cTresAreas.astro';
import M1dCuandoNoUsar from '../components/dia-01/M1dCuandoNoUsar.astro';
import M1eAntesDelTablero from '../components/dia-01/M1eAntesDelTablero.astro';
import M1fElegirHerramienta from '../components/dia-01/M1fElegirHerramienta.astro';
import M2aQueEsModelo from '../components/dia-01/M2aQueEsModelo.astro';
import M2Arquitectura from '../components/dia-01/M2Arquitectura.astro';
import M2cSinModelo from '../components/dia-01/M2cSinModelo.astro';
import M3FuenteConfiable from '../components/dia-01/M3FuenteConfiable.astro';
import M3bLocalVsRemoto from '../components/dia-01/M3bLocalVsRemoto.astro';
import M3cCriterios from '../components/dia-01/M3cCriterios.astro';
import M3dQuizFuente from '../components/dia-01/M3dQuizFuente.astro';
import M3eCita from '../components/dia-01/M3eCita.astro';
import M3fTransicion from '../components/dia-01/M3fTransicion.astro';

// 09:00 Núcleo 1
import M4aContexto from '../components/dia-01/M4aContexto.astro';
import M4a2Descarga from '../components/dia-01/M4a2Descarga.astro';
import M4bArchivos from '../components/dia-01/M4bArchivos.astro';
import M4cFilaAntesDespues from '../components/dia-01/M4cFilaAntesDespues.astro';
import M4dChecklist from '../components/dia-01/M4dChecklist.astro';
import M4ConectarFuentes from '../components/dia-01/M4ConectarFuentes.astro';
import CapturaPowerQuery from '../components/dia-01/CapturaPowerQuery.astro';
import M4TuTurno2Documenta from '../components/dia-01/M4TuTurno2Documenta.astro';
import M4eResultadoEsperado from '../components/dia-01/M4eResultadoEsperado.astro';
import M4fTransicion from '../components/dia-01/M4fTransicion.astro';

// 10:45 Núcleo 2
import M5aContexto from '../components/dia-01/M5aContexto.astro';
import M5bLineaInconsistente from '../components/dia-01/M5bLineaInconsistente.astro';
import M5cTurnoSupervisor from '../components/dia-01/M5cTurnoSupervisor.astro';
import M5dLoteCeros from '../components/dia-01/M5dLoteCeros.astro';
import M5eDuplicados from '../components/dia-01/M5eDuplicados.astro';
import M5TurnosLineas from '../components/dia-01/M5TurnosLineas.astro';
import M5fChecklistCierre from '../components/dia-01/M5fChecklistCierre.astro';
import M6Transicion from '../components/dia-01/M6Transicion.astro';

// 13:15 Laboratorio: Power Query a fondo
import M7CadaPasoQueda from '../components/dia-01/M7CadaPasoQueda.astro';
import M8PowerQueryAFondo from '../components/dia-01/M8PowerQueryAFondo.astro';
import M8cPerfilado from '../components/dia-01/M8cPerfilado.astro';
import M8dConexionCarpeta from '../components/dia-01/M8dConexionCarpeta.astro';
import M8eParametros from '../components/dia-01/M8eParametros.astro';
import M8bChequeo from '../components/dia-01/M8bChequeo.astro';
import M9ColumnasCondicionales from '../components/dia-01/M9ColumnasCondicionales.astro';
import M10ManejoErrores from '../components/dia-01/M10ManejoErrores.astro';
import M10bQuizErrores from '../components/dia-01/M10bQuizErrores.astro';
import M11LaboratorioAplicado from '../components/dia-01/M11LaboratorioAplicado.astro';
import M12Transicion from '../components/dia-01/M12Transicion.astro';

// 15:00 Taller de evidencia
import M13aContexto from '../components/dia-01/M13aContexto.astro';
import M13bRubrica from '../components/dia-01/M13bRubrica.astro';
import M13cDocumentacion from '../components/dia-01/M13cDocumentacion.astro';
import M13TallerEvidencia from '../components/dia-01/M13TallerEvidencia.astro';
import M13dAuditoria from '../components/dia-01/M13dAuditoria.astro';
import M13eChecklistFinal from '../components/dia-01/M13eChecklistFinal.astro';

// 16:30 Validación y cierre
import M14Cierre from '../components/dia-01/M14Cierre.astro';
import M14bRecap from '../components/dia-01/M14bRecap.astro';
import M14cPreview from '../components/dia-01/M14cPreview.astro';
import M14dCompromiso from '../components/dia-01/M14dCompromiso.astro';

// Extra opcional, fuera de las 7.5 h oficiales: para quien termine antes
// o quiera una segunda vuelta de práctica con un archivo que no es el del curso.
import M15Gancho from '../components/dia-01/M15Gancho.astro';
import M16Descarga from '../components/dia-01/M16Descarga.astro';
import M17Columnas from '../components/dia-01/M17Columnas.astro';
import M18Conectar from '../components/dia-01/M18Conectar.astro';
import M19PrimerasVisualizaciones from '../components/dia-01/M19PrimerasVisualizaciones.astro';
import M16bKpis from '../components/dia-01/M16bKpis.astro';
import M18aMttr from '../components/dia-01/M18aMttr.astro';
import M18BaseFallas from '../components/dia-01/M18BaseFallas.astro';
import M18bMtbf from '../components/dia-01/M18bMtbf.astro';
import M18cDisponibilidad from '../components/dia-01/M18cDisponibilidad.astro';
import M20ControlKpis from '../components/dia-01/M20ControlKpis.astro';
---

<RevealDeck titulo="Día 1 · Conexión y preparación de datos">
  <Acto numero={1} palabra="Conectar">
    <Notas slot="notas" minutos={0} dice="Portada de espera. Iniciar la jornada en la siguiente diapositiva." />
  </Acto>

  <!-- 08:00 Fundamento (60 min) -->
  <M0Ruta />
  <M1Gancho />
  <M1bQueNoEs />
  <M1dCuandoNoUsar />
  <M1eAntesDelTablero />
  <M1fElegirHerramienta />
  <M1cTresAreas />
  <M2aQueEsModelo />
  <M2Arquitectura />
  <M2cSinModelo />
  <M3FuenteConfiable />
  <M3bLocalVsRemoto />
  <M3cCriterios />
  <M3dQuizFuente />
  <M3eCita />
  <M3fTransicion />

  <!-- 09:00 Núcleo 1: Conectar las fuentes de piso (90 min) -->
  <M4aContexto />
  <M4a2Descarga />
  <M4bArchivos />
  <M4cFilaAntesDespues />
  <M4dChecklist />
  <CapturaPowerQuery
    archivo="a1-obtener-datos-csv"
    titulo="Conexión a un archivo CSV"
    alt="Ventana Obtener datos de Power Query, con una flecha sobre Texto o CSV."
    indicacion="En Obtener datos, elige Texto o CSV y abre fact_produccion.csv."
    comprueba="Conecta cada uno de los ocho CSV por separado: sus estructuras son diferentes."
  />
  <CapturaPowerQuery
    archivo="a1-vista-previa-csv"
    titulo="Vista previa antes de transformar"
    alt="Vista previa del CSV en UTF-8, delimitado por coma; una flecha señala Transform data."
    indicacion="Revisa UTF-8 y delimitador coma. Elige Transformar datos (Transform data)."
    comprueba="752 y 48 deberían ser 7.52 y 0.48. Revisa Tipo cambiado y convierte los decimales con configuración regional Inglés (Estados Unidos)."
  />
  <M4ConectarFuentes />
  <M4TuTurno2Documenta />
  <M4eResultadoEsperado />
  <M4fTransicion />

  <!-- 10:45 Núcleo 2: Turnos, líneas y lotes en orden (90 min) -->
  <M5aContexto />
  <M5eDuplicados />
  <CapturaPowerQuery
    archivo="a1-quitar-duplicados"
    titulo="Quitar duplicados exactos"
    alt="Menú Reducir filas y Quitar filas, con una flecha sobre Quitar duplicados."
    indicacion="Primero filtra Total día. Selecciona todas las columnas originales y elige Quitar duplicados."
    comprueba="Después de retirar subtotales quedan 7,175 filas. Al quitar 108 duplicados exactos deben quedar 7,067."
  />
  <M5bLineaInconsistente />
  <M5cTurnoSupervisor />
  <M5dLoteCeros />
  <CapturaPowerQuery
    archivo="a1-recortar-espacios"
    titulo="Recortar espacios en tipo_defecto"
    alt="Menú contextual de tipo_defecto con Transformar y Recortar señalado por una flecha."
    indicacion="En fact_calidad, haz clic derecho en tipo_defecto y elige Transformar → Recortar."
    comprueba="Los códigos sin espacios deben coincidir con dim_defecto[defecto_id]."
  />
  <M5TurnosLineas />
  <M5fChecklistCierre />
  <M6Transicion />

  <!-- 13:15 Laboratorio: Power Query a fondo (90 min) -->
  <M7CadaPasoQueda />
  <M8PowerQueryAFondo />
  <M8cPerfilado />
  <CapturaPowerQuery
    archivo="a1-perfil-conjunto-completo"
    titulo="Perfilado sobre el conjunto completo"
    alt="Power Query con calidad, distribución y perfil de columna activos; una flecha señala el perfilado sobre el conjunto completo."
    indicacion="En Vista, activa Calidad, Distribución y Perfil de columna. Abajo, cambia las primeras 1,000 filas por el conjunto completo."
    comprueba="El perfil debe cubrir todos los registros. Un texto válido todavía puede contener una línea mal escrita."
  />
  <M8dConexionCarpeta />
  <M8eParametros />
  <M8bChequeo />
  <M9ColumnasCondicionales />
  <M10ManejoErrores />
  <M10bQuizErrores />
  <M11LaboratorioAplicado />
  <M12Transicion />

  <!-- 15:00 Taller de evidencia: A1 (90 min) -->
  <M13aContexto />
  <M13bRubrica />
  <M13cDocumentacion />
  <M13TallerEvidencia />
  <M13dAuditoria />
  <M13eChecklistFinal />

  <!-- 16:30 Validación y cierre (30 min) -->
  <M14Cierre />
  <M14bRecap />
  <M14cPreview />
  <M14dCompromiso />

  <!-- Extra opcional (no cuenta para las 7.5 h ni para la evidencia A1) -->
  <M15Gancho />
  <M16Descarga />
  <M16bKpis />
  <M17Columnas />
  <M18Conectar />
  <M18BaseFallas />
  <M18aMttr />
  <M18bMtbf />
  <M18cDisponibilidad />
  <M19PrimerasVisualizaciones />
  <M20ControlKpis />
</RevealDeck>
