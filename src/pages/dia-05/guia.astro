---
import { Content } from '../../content/guia-dia-05.md';
import CursoLayout from '../../components/CursoLayout.astro';
import CasoDatos from '../../components/CasoDatos.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<CursoLayout titulo="Un hallazgo que puedes defender." descripcion="Integra A5, presenta tu recomendación en siete minutos y define su entrega." etiqueta="GUÍA DEL DÍA 05 · EVIDENCIA A5">
  <div slot="cabecera">
    <div class="course-meta"><span>7.5 horas de trabajo</span><span>34 diapositivas</span><span>1 evidencia acumulativa</span></div>
    <nav class="course-actions resources" aria-label="Recursos del día 5">
      <a class="button" href={base+'/dia-05/'}>Presentación del día</a>
      <a class="button" href={base+'/descargas/guia-dia-05.md'} download>Descargar guía</a>
      <a class="button" href={base+'/practicas/#dia-5'}>Prácticas del día 5</a>
      <button class="button" type="button" id="imprimir">Imprimir / guardar PDF</button>
    </nav>
  </div>
  <CasoDatos caso="base" descarga="/descargas/dataset-planta-sintetico.zip" />
  <article class="reading"><Content /></article>
</CursoLayout>
<script>document.querySelector('#imprimir')?.addEventListener('click', () => window.print());</script>
