---
import CursoLayout from '../../components/CursoLayout.astro';
import CasoDatos from '../../components/CasoDatos.astro';
import FichaActividad from '../../components/FichaActividad.astro';
import actividades from '../../data/practicas-plan.json';
import fichas from '../../data/practicas-aula.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const temas = {2:'Modelo de datos',3:'Indicadores en DAX',4:'Reporte operativo',5:'Análisis y proyecto final'};
---
<CursoLayout titulo="Prácticas de los días 2–5" descripcion="Abre la actividad, prepara sus materiales y conserva la evidencia en tu reporte acumulativo." etiqueta="16 ACTIVIDADES · 90 MINUTOS CADA UNA">
  <nav slot="cabecera" class="course-actions resources" aria-label="Ir al día">
    {[2,3,4,5].map(dia=><a class="button" href={'#dia-'+dia}>Día {dia}</a>)}
    <a class="button" href={base+'/descargas/practicas/todas-las-actividades.zip'} download>Descargar los 16 paquetes</a>
  </nav>
  <CasoDatos caso="practicas"/>
  <p>Estos cuatro bloques de cada día sustituyen las prácticas de la presentación general. Se conservan fundamentos, pausas y cierre de la jornada.</p>
  {[2,3,4,5].map(dia=><section class="course-section" id={'dia-'+dia} aria-labelledby={'titulo-dia-'+dia}>
    <div class="section-heading"><h2 id={'titulo-dia-'+dia}>Día {dia} · {temas[dia as keyof typeof temas]}</h2><a href={base+'/dia-0'+dia+'/'}>Presentación del día</a></div>
    <div class="activity-grid">{actividades.filter(a=>a.dia===dia).map(a=><article class="activity-card">
      <p class="eyebrow">ACTIVIDAD {a.numero} · 90 MINUTOS</p>
      <h3>{a.titulo}</h3><p>{fichas[a.id as keyof typeof fichas].objetivo}</p>
      <details><summary>Qué abrir, comprobar y entregar</summary><FichaActividad id={a.id as keyof typeof fichas}/></details>
      <nav class="course-actions" aria-label={'Materiales de la actividad '+a.numero}>
        <a class="button button-primary" href={base+'/practicas/'+a.id+'/'}>Diapositivas</a>
        <a class="button" href={base+'/practicas/'+a.id+'/guia/'}>Guía paso a paso</a>
        <a href={base+'/descargas/practicas/actividad-'+a.id+'.zip'} download>Datos y consigna ↓</a>
      </nav>
    </article>)}</div>
  </section>)}
</CursoLayout>
