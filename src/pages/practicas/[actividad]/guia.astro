---
import RecursosGuia from '../../../components/RecursosGuia.astro';
import CursoLayout from '../../../components/CursoLayout.astro';
import CasoDatos from '../../../components/CasoDatos.astro';
import FichaActividad from '../../../components/FichaActividad.astro';
import EstadoPractica from '../../../components/EstadoPractica.astro';
import plan from '../../../data/practicas-plan.json';
import fichas from '../../../data/practicas-aula.json';
export function getStaticPaths() { return plan.map(a => ({params:{actividad:a.id},props:{a}})); }
const {a}=Astro.props;
const f=fichas[a.id as keyof typeof fichas];
const guias=import.meta.glob('../../../content/practicas/*.md');
const {compiledContent}=await guias['../../../content/practicas/'+a.id+'.md']() as any;
// La ficha superior ya presenta este contrato; el ZIP conserva la versión completa.
const contenido=(await compiledContent()).replace(/<h2 id="tu-entrega-paso-a-paso">[\s\S]*?<\/ul>/, '');
---
<CursoLayout titulo={a.numero+' · '+a.titulo} descripcion={f.objetivo} etiqueta={'DÍA '+a.dia+' · GUÍA DE ACTIVIDAD · 90 MINUTOS'}>
  <div slot="cabecera"><RecursosGuia dia={a.dia} actividad={a.id} /></div>
  <EstadoPractica id={a.id}/>
  <FichaActividad id={a.id as keyof typeof fichas}/>
  <CasoDatos caso="practicas"/>
  <article class="reading" set:html={contenido}/>
</CursoLayout>
